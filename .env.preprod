# Environment variables for pre-production
# Simulates Heroku-like configuration

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/orzeny_preprod

# Redis
REDIS_URL=redis://redis:6379/1

# Rails
RAILS_ENV=preprod
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=1

# Jobs
SIDEKIQ_CONCURRENCY=5

# Mail
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_DOMAIN=localhost

# App
PORT=3001
WEB_CONCURRENCY=2

# Security (for development only)
SECRET_KEY_BASE=preprod_secret_key_base_for_development_only_not_for_production

# Features flags (simulates production variables)
ENABLE_AUTOMATION=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Performance
MALLOC_ARENA_MAX=2
RUBY_GC_HEAP_GROWTH_FACTOR=1.1
RUBY_GC_HEAP_GROWTH_MAX_SLOTS=10000
