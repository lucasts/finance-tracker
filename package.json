{
  "name": "finance-tracker",
  "version": "1.0.0",
  "description": "Personal Finance Management Application",
  "main": "app/javascript/application.js",
  "scripts": {
    "test": "yarn jest",
    "test:watch": "yarn jest --watch",
    "test:coverage": "yarn jest --coverage",
    "test:performance": "node test/javascript/performance/web_vitals.test.js"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@hotwired/stimulus": "^3.2.2",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^30.0.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/test/javascript/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^services/(.*)$": "<rootDir>/app/javascript/services/$1",
      "^utilities/(.*)$": "<rootDir>/app/javascript/utilities/$1",
      "^controllers/(.*)$": "<rootDir>/app/javascript/controllers/$1",
      "^config/(.*)$": "<rootDir>/app/javascript/config/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/test/javascript/setup.js"
    ],
    "collectCoverageFrom": [
      "app/javascript/**/*.js",
      "!app/javascript/application.js",
      "!app/javascript/**/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "globals": {
      "__DEV__": true
    }
  }
}
