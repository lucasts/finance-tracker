# Environment variables for production deployment
# Copy this file to .env or set these variables in your deployment platform

# Database Configuration (Required)
DATABASE_URL=postgresql://username:password@localhost:5432/finance_tracker_production

# Rails Configuration
RAILS_ENV=production
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true
RAILS_MASTER_KEY=your_master_key_here

# Application Configuration
SECRET_KEY_BASE=your_secret_key_base_here

# Server Configuration
PORT=3000
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# SSL Configuration (if using HTTPS)
# FORCE_SSL=true

# Application Host (update with your domain)
# HOST=your-domain.com

# Email Configuration (if using ActionMailer)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=your_email@example.com
# SMTP_PASSWORD=your_password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
