{
  "name": "Fin tracker Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "forwardPorts": [3000],
  "postCreateCommand": "bundle install && yarn install",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "extensions": [
        "rebornix.Ruby",
        "castwide.solargraph"
      ]
    }
  },
  "mounts": [
    "source=finance-sqlite-db,target=/workspace/storage/sqlite,type=volume"
  ]
}