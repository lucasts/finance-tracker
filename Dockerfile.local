# Dockerfile.local - ambiente de desenvolvimento
# Focado em rapidez de iteração: inclui toolchain completa, gems dev/test,
# node deps completas e evita precompilar assets.

ARG RUBY_VERSION=3.4.2
FROM ruby:${RUBY_VERSION}

# Variáveis úteis
ENV LANG=C.UTF-8 \
    BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3 \
    BUNDLE_PATH=/usr/local/bundle \
    NODE_ENV=development

# Dependências de sistema (inclui compilers e node para jest / tailwind)
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    postgresql-client \
    curl \
    ca-certificates \
    git \
    nodejs \
    npm && \
    rm -rf /var/lib/apt/lists/*

# Atualiza Node para versão LTS desejada (18.x) usando Nodesource
ARG NODE_MAJOR=18
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get update -qq && apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pre-copia de Gemfile para cache de bundle
COPY Gemfile Gemfile.lock ./
RUN bundle install

# Dependências JS (instala tudo para testes e build dinâmico)
COPY package*.json ./
RUN if [ -f package.json ]; then npm install; fi

# Copia restante do código
COPY . .

# Diretórios esperados
RUN mkdir -p tmp/pids log storage

# Porta padrão em dev (override no compose se necessário)
EXPOSE 3000

# Comando default: usa script bin/dev (foreman) já definido no projeto
CMD ["bash", "-c", "bin/rails db:prepare && bin/dev"]
