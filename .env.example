# Unified environment variables example
# Copy to one of:
#   .env            -> generic local override (loaded manually)
#   .env.local      -> local container-specific overrides
#   .env.preprod    -> preprod (already present) or adapt from this
#   Production: set via platform (Heroku, Render, etc.) not usually committed
#
# -----------------------------------------------------------------------------
# SECTION: Core Rails Environment Selection
# -----------------------------------------------------------------------------
# RAILS_ENV=development   # development (local dev default)
# RAILS_ENV=preprod       # staging / pre-production
# RAILS_ENV=production    # production
# NODE_ENV=development

# -----------------------------------------------------------------------------
# SECTION: Database Configuration
# -----------------------------------------------------------------------------
# Local / Dev (compose) PostgreSQL
DATABASE_URL=postgres://postgres:postgres@db:5432/orzeny_development
# Preprod
# DATABASE_URL=postgres://postgres:postgres@db:5432/orzeny_preprod
# Production (example)
# DATABASE_URL=postgresql://username:password@host:5432/finance_tracker_production

# -----------------------------------------------------------------------------
# SECTION: Redis / Sidekiq
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1
# SIDEKIQ_CONCURRENCY=5

# -----------------------------------------------------------------------------
# SECTION: Mail / SMTP
# -----------------------------------------------------------------------------
SMTP_ADDRESS=mailcatcher
SMTP_PORT=1025
# SMTP_DOMAIN=localhost
# SMTP_USER_NAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true

# -----------------------------------------------------------------------------
# SECTION: App / Server Runtime
# -----------------------------------------------------------------------------
# HOST=localhost:3000
PORT=3000
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# Optional flags / features (preprod or toggles)
# ENABLE_AUTOMATION=true
# ENABLE_BACKGROUND_JOBS=true
# ENABLE_EMAIL_NOTIFICATIONS=false

# -----------------------------------------------------------------------------
# SECTION: Security / Secrets (DO NOT USE THESE DUMMY VALUES IN PROD)
# -----------------------------------------------------------------------------
# For dev/preprod only. In production provide real secrets.
SECRET_KEY_BASE=dev_or_preprod_dummy_key_change_me
# RAILS_MASTER_KEY=your_master_key_here

# -----------------------------------------------------------------------------
# SECTION: Performance Tuning (optional)
# -----------------------------------------------------------------------------
# MALLOC_ARENA_MAX=2
# RUBY_GC_HEAP_GROWTH_FACTOR=1.1
# RUBY_GC_HEAP_GROWTH_MAX_SLOTS=10000

# -----------------------------------------------------------------------------
# SECTION: SSL / Security Hardening (production)
# -----------------------------------------------------------------------------
# FORCE_SSL=true

# -----------------------------------------------------------------------------
# SECTION: Misc / Future Flags
# -----------------------------------------------------------------------------
# ANY_FEATURE_FLAG=false
