<h1 class="text-3xl font-bold mb-6"><%= t('activerecord.models.account.other') %></h1>

<div class="flex justify-between items-center mb-4">
  <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.account.one'), new_account_path, class: "btn btn-primary" %>
</div>

<div class="bg-base-100 rounded-box shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead class="bg-base-200">
        <tr>
          <th><%= t('activerecord.attributes.account.name') %></th>
          <th><%= t('activerecord.attributes.account.account_type') %></th>
          <th class="text-right"><%= t('ui.actions.title') %></th>
        </tr>
      </thead>
      <tbody>
        <% @accounts.each do |account| %>
          <tr>
            <td><%= account.name %></td>
            <td><%= account.account_type.name %></td>
            <td class="text-right">
              <%= link_to 'Editar', edit_account_path(account), class: "link link-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>