<h1><%= t('activerecord.models.account.other') %></h1>

<div>
 <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.account.one'), new_account_path %>
</div>

<div>
 <div>
 <table>
 <thead>
 <tr>
 <th><%= t('activerecord.attributes.account.name') %></th>
 <th><%= t('activerecord.attributes.account.account_type') %></th>
 <th><%= t('ui.actions.title') %></th>
 </tr>
 </thead>
 <tbody>
 <% @accounts.each do |account| %>
 <tr>
 <td><%= account.name %></td>
 <td><%= account.account_type.name %></td>
 <td>
 <%= link_to 'Editar', edit_account_path(account), class: "link link-primary" %>
 </td>
 </tr>
 <% end %>
 </tbody>
 </table>
 </div>
</div>