<% content_for :title, "#{@account.name} - Conta" %>
<% content_for :description, "Detalhes da conta #{@account.name} no #{t('app.name')}" %>

<div>
 <ul>
 <li><%= link_to "Início", root_path %></li>
 <li><%= link_to "Contas", accounts_path %></li>
 <li><%= @account.name %></li>
 </ul>
</div>

<div>
 <div>
 <h1>
 🏦 <%= @account.name %>
 <div>
 <%= @account.account_type.name %>
 </div>
 </h1>
 <p>Detalhes e movimentações da conta</p>
 </div>
 
 <div>
 <%= link_to 'Editar', edit_account_path(@account) %>
 <%= link_to 'Voltar', accounts_path %>
 </div>
</div>

<!-- Account Details Card -->
<div>
 <div>
 <h2>📋 Informações da Conta</h2>
 
 <div>
 <div>
 <div>Nome da Conta</div>
 <div><%= @account.name %></div>
 </div>
 
 <div>
 <div>Tipo de Conta</div>
 <div><%= @account.account_type.name %></div>
 </div>
 </div>
 </div>
</div>

<!-- Recent Transactions -->
<div>
 <div>
 <div>
 <h2>💰 Transações Recentes</h2>
 <%= link_to "Ver todas", transactions_path(account_id: @account.id) %>
 </div>
 
 <% if @account.transactions.any? %>
 <div>
 <table>
 <thead>
 <tr>
 <th>Data</th>
 <th>Descrição</th>
 <th>Categoria</th>
 <th>Valor</th>
 </tr>
 </thead>
 <tbody>
 <% @account.transactions.limit(10).order(created_at: :desc).each do |transaction| %>
 <tr>
 <td><%= l(transaction.transaction_date, format: :short) %></td>
 <td><%= transaction.description %></td>
 <td>
 <div>
 <%= transaction.category.name %>
 </div>
 </td>
 <td>
 <span class="<%= 
 case transaction.transaction_type
 when 'income' then 'text-success'
 when 'expense' then 'text-error'
 when 'transfer' then 'text-warning'
 else 'text-base-content'
 end
 %>">
 <%= 
 case transaction.transaction_type
 when 'income' then '+'
 when 'expense' then '-'
 when 'transfer' then '🔄'
 else ''
 end
 %>R$ <%= number_with_precision(transaction.amount.abs, precision: 2, delimiter: ".") %>
 </span>
 </td>
 </tr>
 <% end %>
 </tbody>
 </table>
 </div>
 <% else %>
 <div>
 <div>💳</div>
 <p>Nenhuma transação encontrada</p>
 <p>As transações aparecerão aqui quando forem criadas</p>
 </div>
 <% end %>
 </div>
</div>
