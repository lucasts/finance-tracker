<div>
 <div>
 <h1>✏️ <%= t('ui.actions.edit') %> <%= t('activerecord.models.transaction.one') %></h1>
 <p>
 <%= t('ui.transaction.edit.subtitle', description: truncate(@transaction.description, length: 40)) %>
 </p>
 </div>
 
 <div>
 <%= link_to transaction_path(@transaction) do %>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
 </svg>
 Ver
 <% end %>
 
 <%= link_to transactions_path do %>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
 </svg>
 Voltar
 <% end %>
 </div>
</div>

<!-- Transaction info card -->
<div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
 </svg>
 <div>
 <h4>Editando transação existente</h4>
 <div>
 Criada em <%= l(@transaction.created_at, format: :short) %> • 
 <span class="<%= 
 case @transaction.transaction_type
 when 'income' then 'text-success'
 when 'expense' then 'text-error'
 when 'transfer' then 'text-warning'
 else 'text-base-content'
 end
 %>">
 <%= 
 case @transaction.transaction_type
 when 'income' then '📈 Receita'
 when 'expense' then '📉 Despesa'
 when 'transfer' then '🔄 Transferência'
 else @transaction.transaction_type.humanize
 end
 %>
 </span> • 
 <%= format_money_unified(@transaction.amount) %>
 </div>
 </div>
</div>

<div>
 <%= render 'form', transaction: @transaction %>
</div>