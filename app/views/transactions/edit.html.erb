<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-3xl font-bold">✏️ Editar Transação</h1>
    <p class="text-base-content/60 mt-1">
      Modificar "<%= truncate(@transaction.description, length: 40) %>"
    </p>
  </div>
  
  <div class="flex gap-2">
    <%= link_to transaction_path(@transaction), class: "btn btn-ghost btn-sm" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
      </svg>
      Ver
    <% end %>
    
    <%= link_to transactions_path, class: "btn btn-ghost btn-sm" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      Voltar
    <% end %>
  </div>
</div>

<!-- Transaction info card -->
<div class="alert alert-info mb-6">
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
  </svg>
  <div>
    <h4 class="font-bold">Editando transação existente</h4>
    <div class="text-sm">
      Criada em <%= l(@transaction.created_at, format: :short) %> • 
      <span class="<%= @transaction.transaction_type == 'income' ? 'text-success' : 'text-error' %>">
        <%= @transaction.transaction_type == 'income' ? '📈 Receita' : '📉 Despesa' %>
      </span> • 
      <%= number_to_currency(@transaction.amount) %>
    </div>
  </div>
</div>

<div class="max-w-4xl mx-auto">
  <%= render 'form', transaction: @transaction %>
</div>