<div data-controller="modal">
<header>
  <h1><%= t('ui.navigation.transactions') %></h1>
  <%= link_to new_transaction_path, class: "new-transaction-button", title: t('ui.actions.new') + ' ' + t('activerecord.models.transaction.one') do %>
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path>
    </svg>
  <% end %>
</header>

<%# Month Navigation %>
<nav class="month-navigation">
  <%= link_to transactions_path(month: @previous_month.strftime("%Y-%m")), class: "month-nav-btn prev" do %>
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    <%= l(@previous_month, format: :month_year) %>
  <% end %>
  
  <h2 class="current-month">
    <%= l(@selected_month, format: :month_year) %>
  </h2>
  
  <%= link_to transactions_path(month: @next_month.strftime("%Y-%m")), class: "month-nav-btn next" do %>
    <%= l(@next_month, format: :month_year) %>
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  <% end %>
</nav>

<% if @transactions.any? %>
  <% income_total = @transactions.select { |t| t.transaction_type == 'income' }.sum(&:amount) %>
  <% expense_total = @transactions.select { |t| t.transaction_type == 'expense' }.sum(&:amount) %>
  <% transfer_total = @transactions.select { |t| t.transaction_type == 'transfer' }.sum(&:amount) %>
  <% balance = income_total - expense_total %>
  <% current_balance = @initial_balance + balance %>
  <% balance_change = @initial_balance != 0 ? ((balance / @initial_balance.abs) * 100).round(1) : 0 %>
  
  <%# Unified Financial Summary - Compact horizontal layout %>
  <section class="financial-summary">
    <%# Opening Balance %>
    <article class="summary-metric opening">
      <label>Saldo Inicial</label>
      <data class="<%= @initial_balance >= 0 ? 'positive' : 'negative' %>">
        <%= format_money(@initial_balance) %>
      </data>
    </article>
    
    <%# Flow Separator %>
    <div class="flow-arrow">→</div>
    
    <%# Monthly Movement %>
    <article class="summary-metric movement">
      <div class="movement-line income">
        <span class="symbol">+</span>
        <label>Receitas</label>
        <data><%= format_money(income_total) %></data>
      </div>
      <div class="movement-line expense">
        <span class="symbol">−</span>
        <label>Despesas</label>
        <data><%= format_money(expense_total) %></data>
      </div>
      <% if transfer_total > 0 %>
        <div class="movement-line transfer">
          <span class="symbol">↔</span>
          <label>Transferências</label>
          <data><%= format_money(transfer_total) %></data>
        </div>
      <% end %>
    </article>
    
    <%# Flow Separator %>
    <div class="flow-arrow">→</div>
    
    <%# Closing Balance %>
    <article class="summary-metric closing">
      <label>Saldo Atual</label>
      <data class="<%= current_balance >= 0 ? 'positive' : 'negative' %>">
        <%= format_money(current_balance) %>
      </data>
      <% if balance != 0 && @initial_balance != 0 %>
        <small class="<%= balance >= 0 ? 'positive' : 'negative' %>">
          <%= balance >= 0 ? '↗' : '↘' %> <%= balance >= 0 ? '+' : '' %><%= balance_change %>%
        </small>
      <% end %>
    </article>
  </section>
<% end %>

<section class="filters" data-controller="collapsible">
  <header data-action="click->collapsible#toggle">
    <h3>
      <%= t('ui.filters.title') %>
      <% if params[:account_id].present? || params[:transaction_type].present? || params[:month].present? %>
        <mark class="active"><%= t('ui.filters.active') %></mark>
      <% end %>
    </h3>
    <svg data-collapsible-target="icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </header>
  
  <div data-collapsible-target="content" class="hidden">
    <%= form_with url: transactions_path, method: :get, local: true do |f| %>
      <fieldset>
        <div>
          <label><%= t('activerecord.models.account.one') %></label>
          <%= select_tag :account_id, 
                         options_from_collection_for_select(Account.all, :id, :name, params[:account_id]), 
                         prompt: t('ui.filters.all') %>
        </div>
        
        <div>
          <label><%= t('activerecord.attributes.transaction.transaction_type') %></label>
          <%= select_tag :transaction_type, 
                         options_for_select([
                           [t('ui.filters.all'), nil], 
                           [t('ui.transaction.types.income'), "income"], 
                           [t('ui.transaction.types.expense'), "expense"], 
                           [t('ui.transaction.types.transfer'), "transfer"]
                         ], params[:transaction_type]) %>
        </div>
        
        <div>
          <label><%= t('ui.filters.month') %></label>
          <%= month_field_tag :month, params[:month] %>
        </div>
      </fieldset>
      
      <footer>
        <%= submit_tag t('ui.actions.filter') %>
        <%= link_to t('ui.actions.clear'), transactions_path, class: "secondary" %>
      </footer>
    <% end %>
  </div>
</section>

<!-- All Transactions in unified list -->
<% if @transactions.any? %>
 <%= render 'transactions_table', transactions: @transactions, initial_balance: @initial_balance %>
<% end %>

<% if @transactions.empty? %>
  <article class="empty-state">
    <div class="icon">💰</div>
    <h3><%= t('ui.transaction.empty.title') %></h3>
    <p>
      <% if params[:account_id].present? || params[:transaction_type].present? || params[:month].present? %>
        <%= t('ui.transaction.empty.filtered') %>
      <% else %>
        <%= t('ui.transaction.empty.first_time') %>
      <% end %>
    </p>
    <footer>
      <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.transaction.one'), new_transaction_path %>
      <% if params[:account_id].present? || params[:transaction_type].present? || params[:month].present? %>
        <%= link_to t('ui.filters.clear_filters'), transactions_path, class: "secondary" %>
      <% end %>
    </footer>
  </article>
<% end %>

<!-- Transaction Details Modal -->
<dialog id="transaction_modal" data-modal-target="dialog">
 <div data-modal-target="content">
 <!-- Content will be loaded here -->
 </div>
 <form method="dialog" >
 <button>close</button>
 </form>
</dialog>

</div> <!-- Close modal controller div -->
