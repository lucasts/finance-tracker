<div data-controller="modal">
<h1 class="text-3xl font-bold mb-6"><%= t('ui.navigation.transactions') %></h1>

<div class="flex justify-between items-center mb-4">
  <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.transaction.one'), new_transaction_path, class: "btn btn-primary" %>
</div>

<% if @transactions.any? %>
  <% income_total = @transactions.select { |t| t.transaction_type == 'income' }.sum(&:amount) %>
  <% expense_total = @transactions.select { |t| t.transaction_type == 'expense' }.sum(&:amount) %>
  <% balance = income_total - expense_total %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="alert alert-success">
      <div class="flex-1">
        <label class="label-text"><%= t('ui.transaction.types.income').pluralize %></label>
        <p class="text-xl font-bold"><%= number_to_currency(income_total) %></p>
      </div>
    </div>
    <div class="alert alert-error">
      <div class="flex-1">
        <label class="label-text"><%= t('ui.transaction.types.expense').pluralize %></label>
        <p class="text-xl font-bold"><%= number_to_currency(expense_total) %></p>
      </div>
    </div>
    <div class="alert alert-info">
      <div class="flex-1">
        <label class="label-text"><%= t('ui.filters.balance') %></label>
        <p class="text-xl font-bold"><%= number_to_currency(balance) %></p>
      </div>
    </div>
  </div>
<% end %>

<div class="mb-6 bg-base-100 rounded-box shadow" data-controller="collapsible">
  <!-- Collapsible Header -->
  <div class="p-4 border-b border-base-300 cursor-pointer" data-action="click->collapsible#toggle">
    <div class="flex justify-between items-center">
      <h3 class="text-lg font-semibold">
        <%= t('ui.filters.title') %>
        <% if params[:account_id].present? || params[:transaction_type].present? || params[:month].present? %>
          <span class="badge badge-primary badge-sm ml-2"><%= t('ui.filters.active') %></span>
        <% end %>
      </h3>
      <svg data-collapsible-target="icon" class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>
  </div>
  
  <!-- Collapsible Content -->
  <div data-collapsible-target="content" class="p-4">
    <%= form_with url: transactions_path, method: :get, local: true do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="form-control">
          <label class="label">
            <span class="label-text"><%= t('activerecord.models.account.one') %></span>
          </label>
          <%= select_tag :account_id, options_from_collection_for_select(Account.all, :id, :name, params[:account_id]), prompt: t('ui.filters.all'), class: "select select-bordered w-full" %>
        </div>
        <div class="form-control">
          <label class="label">
            <span class="label-text"><%= t('activerecord.attributes.transaction.transaction_type') %></span>
          </label>
          <%= select_tag :transaction_type, options_for_select([[t('ui.filters.all'), nil], [t('ui.transaction.types.income'), "income"], [t('ui.transaction.types.expense'), "expense"]], params[:transaction_type]), class: "select select-bordered w-full" %>
        </div>
        <div class="form-control">
          <label class="label">
            <span class="label-text"><%= t('ui.filters.month') %></span>
          </label>
          <%= month_field_tag :month, params[:month], class: "input input-bordered w-full" %>
        </div>
        <div class="form-control justify-end">
          <div class="flex space-x-2">
            <%= submit_tag t('ui.actions.filter'), class: "btn btn-primary" %>
            <%= link_to t('ui.actions.clear'), transactions_path, class: "btn btn-ghost" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% grouped = @transactions.group_by(&:transaction_group) %>
<% grouped.each do |group, transactions| %>
  <% if group.present? %>
    <div class="alert alert-info mt-6 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <div>
        <h3 class="font-bold">💳 <%= t('ui.transaction.installments.title') %></h3>
        <div class="text-xs"><%= group.name %></div>
      </div>
    </div>
  <% end %>

  <% running_balance = 0 %>
  <div class="bg-base-100 rounded-box shadow overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full text-sm">
        <thead class="bg-base-200">
          <tr>
            <th><%= t('ui.transaction.table.event') %></th>
            <th><%= t('ui.transaction.table.payment') %></th>
            <th><%= t('activerecord.attributes.transaction.description') %></th>
            <th><%= t('ui.transaction.table.origin') %></th>
            <th><%= t('ui.transaction.table.destination') %></th>
            <th><%= t('activerecord.attributes.transaction.category') %></th>
            <th class="text-right"><%= t('activerecord.attributes.transaction.amount') %></th>
            <th class="text-right"><%= t('activerecord.attributes.transaction.installment') %></th>
            <th class="text-right"><%= t('ui.transaction.table.accumulated_balance') %></th>
            <th class="text-right"><%= t('ui.actions.title') %></th>
          </tr>
        </thead>
      <tbody>
        <% transactions.each do |tx| %>
          <% delta = tx.transaction_type == 'income' ? tx.amount : -tx.amount %>
          <% running_balance += delta %>
          <tr>
            <td><%= l(tx.event_date) if tx.event_date %></td>
            <td><%= l(tx.payment_date) if tx.payment_date %></td>
            <td><%= tx.description %></td>
            <td><%= tx.from_account.name %></td>
            <td><%= tx.to_account&.name %></td>
            <td><%= tx.category.name %></td>
            <td class="text-right <%= tx.transaction_type == 'income' ? 'text-success' : 'text-error' %>">
              <%= number_to_currency(tx.amount, unit: 'R$', separator: ',', delimiter: '.') %>
            </td>
            <td class="text-right">
              <% if group.present? %>
                <%= "#{tx.installment}/#{tx.transaction_group.installment_count}" %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="text-right text-base-content/60">
              <%= number_to_currency(running_balance, unit: 'R$', separator: ',', delimiter: '.') %>
            </td>
            <td class="text-right">
              <div class="flex gap-1 justify-end">
                <button class="btn btn-ghost btn-xs" 
                        data-action="click->modal#show" 
                        data-url="<%= transaction_path(tx) %>"
                        title="<%= t('ui.actions.show') %>">
                  👁️
                </button>
                <%= link_to edit_transaction_path(tx), class: "btn btn-ghost btn-xs", title: t('ui.actions.edit') do %>
                  ✏️
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>

<% if @transactions.empty? %>
  <div class="bg-base-100 rounded-box shadow p-8 text-center">
    <div class="text-6xl mb-4">💰</div>
    <h3 class="text-xl font-semibold mb-2"><%= t('ui.transaction.empty.title') %></h3>
    <p class="text-base-content/60 mb-4">
      <% if params[:account_id].present? || params[:transaction_type].present? || params[:month].present? %>
        <%= t('ui.transaction.empty.filtered') %>
      <% else %>
        <%= t('ui.transaction.empty.first_time') %>
      <% end %>
    </p>
    <div class="flex gap-2 justify-center">
      <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.transaction.one'), new_transaction_path, class: "btn btn-primary" %>
      <% if params[:account_id].present? || params[:transaction_type].present? || params[:month].present? %>
        <%= link_to t('ui.filters.clear_filters'), transactions_path, class: "btn btn-ghost" %>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Transaction Details Modal -->
<input type="checkbox" id="transaction_modal" class="modal-toggle" data-modal-target="modal">
<div class="modal" data-action="click->modal#closeOnBackdrop">
  <div class="modal-box max-w-4xl w-11/12" data-modal-target="content">
    <!-- Content will be loaded here -->
  </div>
</div>

</div> <!-- Close modal controller div -->
