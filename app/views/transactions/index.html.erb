<!-- app/views/transactions/index.html.erb -->
<h1 class="text-2xl font-bold mb-6">Lançamentos</h1>

<div class="flex justify-between items-center mb-4">
  <%= link_to 'Novo lançamento', new_transaction_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
</div>

<table class="w-full bg-white shadow rounded text-sm">
  <thead class="bg-gray-100 text-gray-600">
    <tr>
      <th class="p-2 text-left">Data</th>
      <th class="p-2 text-left">Descrição</th>
      <th class="p-2 text-left">Conta Origem</th>
      <th class="p-2 text-left">Conta Destino</th>
      <th class="p-2 text-left">Categoria</th>
      <th class="p-2 text-right">Valor</th>
      <th class="p-2">Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @transactions.each do |tx| %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-2"><%= l(tx.date, format: :short) %></td>
        <td class="p-2"><%= tx.description %></td>
        <td class="p-2"><%= tx.from_account.name %></td>
        <td class="p-2"><%= tx.to_account&.name %></td>
        <td class="p-2"><%= tx.category.name %></td>
        <td class="p-2 text-right font-semibold <%= tx.transaction_type == 'income' ? 'text-green-600' : 'text-red-600' %>">
          <%= number_to_currency(tx.amount, unit: 'R$', separator: ',', delimiter: '.') %>
        </td>
        <td class="p-2 text-right">
          <%= link_to 'Editar', edit_transaction_path(tx), class: "text-blue-600 hover:underline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
