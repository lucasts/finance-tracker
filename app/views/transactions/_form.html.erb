<%= form_with(model: transaction, local: true, data: { controller: "transaction-form" }) do |form| %>
  <div class="space-y-6">
    
    <!-- Transaction Type Selection (moved to top for better UX) -->
    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body py-4">
        <h3 class="card-title text-lg mb-3">💰 Tipo de Transação</h3>
        <div class="flex gap-4">
          <%= form.radio_button :transaction_type, "income", 
                class: "radio radio-success", 
                data: { 
                  transaction_form_target: "transactionType",
                  action: "change->transaction-form#handleTypeChange" 
                } %>
          <%= form.label :transaction_type_income, "📈 Receita", class: "cursor-pointer flex items-center gap-2" %>
          
          <%= form.radio_button :transaction_type, "expense", 
                class: "radio radio-error ml-6", 
                data: { 
                  transaction_form_target: "transactionType",
                  action: "change->transaction-form#handleTypeChange" 
                } %>
          <%= form.label :transaction_type_expense, "📉 Despesa", class: "cursor-pointer flex items-center gap-2" %>
        </div>
      </div>
    </div>

    <!-- Basic Information -->
    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body">
        <h3 class="card-title text-lg mb-4">📝 Informações Básicas</h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="lg:col-span-2">
            <%= form_group(form, :description, 
                  placeholder: "Ex: Supermercado Zaffari, Salário, Freelance...",
                  data: { 
                    transaction_form_target: "description",
                    action: "input->transaction-form#handleDescriptionChange"
                  }) %>
          </div>
          
          <div class="form-control">
            <label class="label">
              <span class="label-text">💵 Valor</span>
            </label>
            <%= form.number_field :amount, 
                  class: "input input-bordered w-full text-lg font-bold", 
                  step: 0.01, 
                  min: 0.01,
                  placeholder: "0,00",
                  data: { 
                    transaction_form_target: "amount",
                    action: "input->transaction-form#handleAmountChange"
                  } %>
            <label class="label">
              <span class="label-text-alt text-base-content/60" data-transaction-form-target="amountHelper">
                Digite o valor da transação
              </span>
            </label>
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text">📅 Data do Evento</span>
              <span class="label-text-alt text-base-content/60">(Competência)</span>
            </label>
            <%= form.date_field :event_date, 
                  class: "input input-bordered w-full", 
                  value: transaction.event_date || Date.current,
                  data: { 
                    transaction_form_target: "eventDate",
                    action: "change->transaction-form#handleDateChange"
                  } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Accounts Selection -->
    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body">
        <h3 class="card-title text-lg mb-4">
          <span data-transaction-form-target="accountsTitle">🏦 Contas</span>
        </h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="form-control">
            <label class="label">
              <span class="label-text" data-transaction-form-target="fromAccountLabel">
                Conta de Origem
              </span>
            </label>
            <%= form.collection_select :from_account_id, 
                  Account.includes(:account_type).order(:name), 
                  :id, 
                  ->(account) { "#{account.name} (#{account.account_type.name})" },
                  { prompt: "Selecione a conta" }, 
                  { 
                    class: "select select-bordered w-full",
                    data: { 
                      transaction_form_target: "fromAccount",
                      action: "change->transaction-form#handleAccountChange"
                    }
                  } %>
            <label class="label">
              <span class="label-text-alt" data-transaction-form-target="fromAccountHelper">
                De onde sai o dinheiro
              </span>
            </label>
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text" data-transaction-form-target="toAccountLabel">
                Conta de Destino
              </span>
            </label>
            <%= form.collection_select :to_account_id, 
                  Account.includes(:account_type).order(:name), 
                  :id, 
                  ->(account) { "#{account.name} (#{account.account_type.name})" },
                  { prompt: "Selecione a conta" }, 
                  { 
                    class: "select select-bordered w-full",
                    data: { 
                      transaction_form_target: "toAccount",
                      action: "change->transaction-form#handleToAccountChange"
                    }
                  } %>
            <label class="label">
              <span class="label-text-alt" data-transaction-form-target="toAccountHelper">
                Para onde vai o dinheiro
              </span>
            </label>
          </div>
        </div>

        <!-- Payment Date (conditional) -->
        <div data-transaction-form-target="paymentDateSection" class="form-control mt-4">
          <label class="label">
            <span class="label-text">💳 Data de Pagamento</span>
            <span class="label-text-alt text-base-content/60">(Caixa)</span>
          </label>
          <%= form.date_field :payment_date, 
                class: "input input-bordered w-full", 
                data: { transaction_form_target: "paymentDate" } %>
          <label class="label">
            <span class="label-text-alt" data-transaction-form-target="paymentDateHelper">
              Quando o dinheiro realmente sai/entra na conta
            </span>
          </label>
        </div>

        <!-- Credit Card Info (conditional) -->
        <div data-transaction-form-target="creditCardInfo" class="hidden">
          <div class="alert alert-info mt-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <div>
              <h4 class="font-bold">Transação de Cartão de Crédito</h4>
              <div class="text-sm" data-transaction-form-target="creditCardDetails">
                Esta transação será automaticamente associada à fatura apropriada.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Category and Classification -->
    <div class="card bg-base-100 shadow-sm border border-base-300">
      <div class="card-body">
        <h3 class="card-title text-lg mb-4">🏷️ Categorização</h3>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
          <div class="lg:col-span-2">
            <%= form_select_group(form, :category_id, 
                  Category.order(:name), 
                  :id, 
                  :name, 
                  label: "Categoria",
                  data: { 
                    transaction_form_target: "category",
                    action: "change->transaction-form#handleCategoryChange"
                  }) %>
          </div>
        </div>

        <!-- Category suggestions -->
        <div data-transaction-form-target="categorySuggestions" class="hidden mt-3">
          <div class="text-sm text-base-content/60 mb-2">💡 Sugestões baseadas na descrição:</div>
          <div class="flex flex-wrap gap-2" data-transaction-form-target="suggestionButtons">
            <!-- Suggestions will be populated by JavaScript -->
          </div>
        </div>
      </div>
    </div>

    <!-- Installments Section -->
    <div class="card bg-base-100 shadow-sm border border-base-300" data-controller="parceling">
      <div class="card-body">
        <h3 class="card-title text-lg mb-4">📊 Parcelamento</h3>
        
        <% if transaction.transaction_group_id.present? %>
          <!-- Exibir informações do parcelamento existente -->
          <div class="alert alert-info">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h4 class="font-bold">Transação Parcelada</h4>
              <div class="text-sm">
                <%= transaction.description %> - 
                Parcela <%= transaction.installment || 'N/A' %> de <%= transaction.transaction_group.installments_count || transaction.transaction_group.transactions.count %>
                <% if transaction.transaction_group.total_amount.present? %>
                  <br>Valor total: <%= number_to_currency(transaction.transaction_group.total_amount) %>
                <% end %>
              </div>
              <div class="mt-2">
                <%= link_to "Ver todas as parcelas", transactions_path(group: transaction.transaction_group_id), 
                      class: "btn btn-sm btn-outline btn-primary" %>
              </div>
            </div>
          </div>
        <% else %>
          <!-- Interface para novo parcelamento -->
          <div class="form-control">
            <label class="cursor-pointer label justify-start gap-3">
              <%= check_box_tag :is_installment, "1", false, 
                    class: "checkbox checkbox-primary",
                    data: { 
                      parceling_target: "toggle", 
                      action: "change->parceling#toggle" 
                    } %>
              <span class="label-text">Parcelar esta transação?</span>
            </label>
          </div>
        <% end %>

        <% unless transaction.transaction_group_id.present? %>
          <div data-parceling-target="section" class="space-y-4 mt-4 hidden">
            <div class="alert alert-info">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <div>
                <h4 class="font-bold">Parcelamento Automático</h4>
                <div class="text-sm">
                  Informe quantas parcelas mensais deseja. O sistema usará o valor já informado acima e criará automaticamente todas as transações.
                </div>
              </div>
            </div>

            <div class="form-control max-w-sm">
              <label class="label">
                <span class="label-text">📅 Número de Parcelas</span>
              </label>
              <%= number_field_tag :installments_count, "", 
                    placeholder: "Ex: 10", 
                    min: 2,
                    max: 60,
                    class: "input input-bordered w-full",
                    data: { 
                      parceling_target: "installmentsCount",
                      action: "input->parceling#calculateInstallment keyup->parceling#calculateInstallment"
                    } %>
              <label class="label">
                <span class="label-text-alt">Entre 2 e 60 parcelas mensais</span>
              </label>
            </div>

            <!-- Preview das parcelas -->
            <div data-parceling-target="preview" class="hidden">
              <div class="divider">📋 Prévia do Parcelamento</div>
              <div class="bg-base-200 rounded-lg p-4 transition-all duration-300">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
                  <div>
                    <div class="text-2xl font-bold text-primary" data-parceling-target="installmentValue">R$ 0,00</div>
                    <div class="text-sm text-base-content/60">Valor por parcela</div>
                  </div>
                  <div>
                    <div class="text-2xl font-bold text-secondary" data-parceling-target="firstDate">-</div>
                    <div class="text-sm text-base-content/60">Primeira parcela</div>
                  </div>
                  <div>
                    <div class="text-2xl font-bold text-accent" data-parceling-target="lastDate">-</div>
                    <div class="text-sm text-base-content/60">Última parcela</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Input hidden para o backend -->
            <%= hidden_field_tag :create_installments, "", data: { parceling_target: "createInstallments" } %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Advanced Options (collapsible) -->
    <div class="card bg-base-100 shadow-sm border border-base-300" data-controller="collapsible">
      <div class="card-body">
        <div class="cursor-pointer" data-action="click->collapsible#toggle">
          <h3 class="card-title text-lg">
            ⚙️ Opções Avançadas
            <svg data-collapsible-target="icon" class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </h3>
        </div>
        
        <div data-collapsible-target="content" class="hidden mt-4 space-y-4">
          <div class="form-control">
            <label class="label">
              <span class="label-text">Status da Transação</span>
            </label>
            <%= form.select :status, 
                  options_for_select([
                    ["Pendente", "pending"], 
                    ["Confirmada", "confirmed"], 
                    ["Cancelada", "cancelled"]
                  ], transaction.status || "confirmed"), 
                  {}, 
                  { class: "select select-bordered w-full" } %>
          </div>

          <div class="form-control">
            <label class="label">
              <span class="label-text">Tipo de Recorrência</span>
            </label>
            <%= form.select :recurrence_type, 
                  options_for_select([
                    ["Única", "single"], 
                    ["Fixa (mensalmente)", "fixed"], 
                    ["Recorrente", "recurring"]
                  ], transaction.recurrence_type || "single"), 
                  {}, 
                  { class: "select select-bordered w-full" } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex justify-end gap-3 pt-4">
      <%= link_to "Cancelar", transactions_path, 
            class: "btn btn-ghost" %>
      <%= form.submit transaction.persisted? ? "Atualizar Transação" : "Criar Transação", 
            class: "btn btn-primary",
            data: { transaction_form_target: "submitButton" } %>
    </div>
  </div>

  <!-- Hidden data for JavaScript -->
  <script type="application/json" data-transaction-form-target="accountData">
    <%= raw Account.includes(:account_type).map { |account| {
      id: account.id,
      name: account.name,
      type_code: account.account_type.code,
      type_name: account.account_type.name,
      closing_day: account.closing_day,
      due_day: account.due_day
    }}.to_json %>
  </script>

  <script type="application/json" data-transaction-form-target="categoryData">
    <%= raw Category.order(:name).map { |category| {
      id: category.id,
      name: category.name
    }}.to_json %>
  </script>
<% end %>