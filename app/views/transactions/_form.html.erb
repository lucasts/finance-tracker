<%= form_with(model: transaction, local: true) do |form| %>
  <div class="space-y-4">
    <%= form_group(form, :description) %>
    <%= form_group(form, :amount, type: :number_field, step: 0.01) %>
    <%= form_group(form, :date, type: :date_field) %>
    <%= form_group(form, :period) %>
    <%= form_select_group(form, :from_account_id, Account.all, :id, :name, label: "Conta de Origem") %>
    <%= form_select_group(form, :to_account_id, Account.all, :id, :name, label: "Conta de Destino") %>
    <%= form_select_group(form, :category_id, Category.all, :id, :name, label: "Categoria") %>
    <%= form_group(form, :transaction_type, type: :select, options: options_for_select(["income", "expense"], selected: transaction.transaction_type)) %>

    <div>
      <%= check_box_tag :show_parcelamento, "1", transaction.transaction_group_id.present?, data: { controller: "toggle" } %>
      <%= label_tag :show_parcelamento, "Parcelar esta transação?" %>
    </div>

    <div data-toggle-target="section" class="space-y-4 <%= transaction.transaction_group_id.present? ? '' : 'hidden' %>">
      <%= form_group(form, :installment, type: :number_field, label: "Número da Parcela (ex: 1 para 1/3)") %>
      <%= form_select_group(form, :transaction_group_id, TransactionGroup.all, :id, :name, label: "Grupo de Parcelamento") %>
    </div>

    <%= primary_button("Salvar") %>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const checkbox = document.querySelector('[data-controller="toggle"]')
    const section = document.querySelector('[data-toggle-target="section"]')
    if (checkbox && section) {
      checkbox.addEventListener("change", () => {
        section.classList.toggle("hidden", !checkbox.checked)
      })
    }
  })
</script>