<%# filepath: app/views/transactions/_transaction_details.html.erb %>
<div class="bg-base-100 rounded-lg">
  <!-- Modal Header -->
  <div class="flex justify-between items-center p-6 border-b border-base-300">
    <div class="flex items-center gap-3">
      <div class="avatar">
        <div class="w-10 h-10 rounded-full bg-<%= 
          case transaction.transaction_type
          when 'income' then 'success'
          when 'expense' then 'error'
          when 'transfer' then 'warning'
          else 'neutral'
          end
        %> text-<%= 
          case transaction.transaction_type  
          when 'income' then 'success'
          when 'expense' then 'error'
          when 'transfer' then 'warning'
          else 'neutral'
          end
        %>-content flex items-center justify-center">
          <%= 
            case transaction.transaction_type
            when 'income' then '💰'
            when 'expense' then '💳'
            when 'transfer' then '🔄'
            else '📊'
            end
          %>
        </div>
      </div>
      <div>
        <h3 class="text-xl font-bold">Detalhes do Lançamento</h3>
        <p class="text-sm text-base-content/60"><%= transaction.description %></p>
      </div>
    </div>
    <label for="transaction_modal" class="btn btn-sm btn-circle btn-ghost" data-action="click->modal#hide">✕</label>
  </div>

  <!-- Modal Body -->
  <div class="p-6 space-y-6">
    <!-- Amount and Type -->
    <div class="stats stats-horizontal shadow w-full">
      <div class="stat">
        <div class="stat-figure text-<%= 
          case transaction.transaction_type
          when 'income' then 'success'
          when 'expense' then 'error'
          when 'transfer' then 'warning'
          else 'neutral'
          end
        %>">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
            <% case transaction.transaction_type %>
            <% when 'income' %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            <% when 'expense' %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
            <% when 'transfer' %>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
            <% end %>
          </svg>
        </div>
        <div class="stat-title">Valor</div>
        <div class="stat-value text-<%= 
          case transaction.transaction_type
          when 'income' then 'success'
          when 'expense' then 'error'
          when 'transfer' then 'warning'
          else 'neutral'
          end
        %>">
          <%= format_money_unified(transaction.amount) %>
        </div>
        <div class="stat-desc">
          <span class="badge badge-<%= 
            case transaction.transaction_type
            when 'income' then 'success'
            when 'expense' then 'error'
            when 'transfer' then 'warning'
            else 'neutral'
            end
          %> badge-sm">
            <%= 
              case transaction.transaction_type
              when 'income' then 'Receita'
              when 'expense' then 'Despesa'
              when 'transfer' then 'Transferência'
              else transaction.transaction_type.humanize
              end
            %>
          </span>
        </div>
      </div>
    </div>

    <!-- Transaction Details -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Dates -->
      <div class="card bg-base-200">
        <div class="card-body p-4">
          <h4 class="card-title text-sm flex items-center gap-2">
            📅 Datas
          </h4>
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-base-content/60">Data do Evento:</span>
              <span class="font-medium"><%= l(transaction.event_date, format: :short) if transaction.event_date %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-base-content/60">Data do Pagamento:</span>
              <span class="font-medium"><%= l(transaction.payment_date, format: :short) if transaction.payment_date %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Accounts -->
      <div class="card bg-base-200">
        <div class="card-body p-4">
          <h4 class="card-title text-sm flex items-center gap-2">
            🏦 Contas
          </h4>
          <div class="space-y-2 text-sm">
            <% credit_entry = transaction.entries.find { |e| e.entry_type == 'credit' } %>
            <% debit_entry = transaction.entries.find { |e| e.entry_type == 'debit' } %>
            
            <% if credit_entry %>
              <div class="flex justify-between">
                <span class="text-base-content/60">Origem:</span>
                <span class="font-medium"><%= credit_entry.account.name %></span>
              </div>
            <% end %>
            
            <% if debit_entry %>
              <div class="flex justify-between">
                <span class="text-base-content/60">Destino:</span>
                <span class="font-medium"><%= debit_entry.account.name %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Category -->
      <div class="card bg-base-200">
        <div class="card-body p-4">
          <h4 class="card-title text-sm flex items-center gap-2">
            🏷️ Categoria
          </h4>
          <div class="text-sm">
            <% if transaction.category.present? %>
              <span class="badge badge-primary"><%= transaction.category.name %></span>
            <% else %>
              <span class="text-base-content/50 italic">
                <%= transaction.transaction_type == 'transfer' ? 'N/A (Transferência)' : 'Não informado' %>
              </span>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Status -->
      <div class="card bg-base-200">
        <div class="card-body p-4">
          <h4 class="card-title text-sm flex items-center gap-2">
            📊 Status
          </h4>
          <div class="text-sm">
            <span class="badge badge-<%= transaction.status == 'confirmed' ? 'success' : transaction.status == 'pending' ? 'warning' : 'error' %>">
              <%= transaction.status == 'confirmed' ? '✅ Confirmado' : transaction.status == 'pending' ? '⏳ Pendente' : '❌ Cancelado' %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Installment Info (if part of a plan) -->
    <% if transaction.installment_plan.present? %>
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <div>
          <h4 class="font-bold">💳 Parcelamento</h4>
          <div class="text-sm">
            <p>Plano: <strong><%= transaction.installment_plan.name %></strong></p>
            <p>Parcela: <strong><%= transaction.installment_number %>/<%= transaction.installment_plan.installment_count %></strong></p>
            <div class="mt-2">
              <%= link_to 'Ver todas as parcelas', installment_plan_path(transaction.installment_plan), class: "link link-primary text-xs" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Recurring Commitment Info -->
    <% if transaction.recurring_commitment.present? %>
      <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
        </svg>
        <div>
          <h4 class="font-bold">🔄 Compromisso Recorrente</h4>
          <div class="text-sm">
            <p>Compromisso: <strong><%= transaction.recurring_commitment.name %></strong></p>
            <p>Frequência: <strong><%= transaction.recurring_commitment.recurrence_frequency.humanize %></strong></p>
            <div class="mt-2">
              <%= link_to 'Ver compromisso', recurring_commitment_path(transaction.recurring_commitment), class: "link link-primary text-xs" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Modal Footer -->
  <div class="flex justify-between items-center p-6 border-t border-base-300">
    <div class="text-xs text-base-content/60">
      ID: <%= transaction.id %>
    </div>
    <div class="flex gap-2">
      <%= link_to 'Editar', edit_transaction_path(transaction), class: "btn btn-primary btn-sm" %>
      <label for="transaction_modal" class="btn btn-ghost btn-sm" data-action="click->modal#hide">Fechar</label>
    </div>
  </div>
</div>
