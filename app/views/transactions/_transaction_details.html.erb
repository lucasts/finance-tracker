<%# filepath: app/views/transactions/_transaction_details.html.erb %>
<div>
 <!-- Modal Header -->
 <div>
 <div>
 <div>
 <div>
 <%= 
 case transaction.transaction_type
 when 'income' then '💰'
 when 'expense' then '💳'
 when 'transfer' then '🔄'
 else '📊'
 end
 %>
 </div>
 </div>
 <div>
 <h3>Detalhes do Lançamento</h3>
 <p><%= transaction.description %></p>
 </div>
 </div>
 <label for="transaction_modal" data-action="click->modal#hide">✕</label>
 </div>

 <!-- Modal Body -->
 <div>
 <!-- Amount and Type -->
 <div>
 <div>
 <div class="stat-figure text-<%= 
 case transaction.transaction_type
 when 'income' then 'success'
 when 'expense' then 'error'
 when 'transfer' then 'warning'
 else 'neutral'
 end
 %>">
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <% case transaction.transaction_type %>
 <% when 'income' %>
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
 <% when 'expense' %>
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
 <% when 'transfer' %>
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
 <% end %>
 </svg>
 </div>
 <div>Valor</div>
 <div class="stat-value text-<%= 
 case transaction.transaction_type
 when 'income' then 'success'
 when 'expense' then 'error'
 when 'transfer' then 'warning'
 else 'neutral'
 end
 %>">
 <%= format_money_unified(transaction.amount) %>
 </div>
 <div>
 <span>
 <%= 
 case transaction.transaction_type
 when 'income' then 'Receita'
 when 'expense' then 'Despesa'
 when 'transfer' then 'Transferência'
 else transaction.transaction_type.humanize
 end
 %>
 </span>
 </div>
 </div>
 </div>

 <!-- Transaction Details -->
 <div>
 <!-- Dates -->
 <div>
 <div>
 <h4>
 📅 Datas
 </h4>
 <div>
 <div>
 <span>Data do Evento:</span>
 <span><%= l(transaction.event_date, format: :short) if transaction.event_date %></span>
 </div>
 <div>
 <span>Data do Pagamento:</span>
 <span><%= l(transaction.payment_date, format: :short) if transaction.payment_date %></span>
 </div>
 </div>
 </div>
 </div>

 <!-- Accounts -->
 <div>
 <div>
 <h4>
 🏦 Contas
 </h4>
 <div>
 <% credit_entry = transaction.entries.find { |e| e.entry_type == 'credit' } %>
 <% debit_entry = transaction.entries.find { |e| e.entry_type == 'debit' } %>
 
 <% if credit_entry %>
 <div>
 <span>Origem:</span>
 <span><%= credit_entry.account.name %></span>
 </div>
 <% end %>
 
 <% if debit_entry %>
 <div>
 <span>Destino:</span>
 <span><%= debit_entry.account.name %></span>
 </div>
 <% end %>
 </div>
 </div>
 </div>

 <!-- Category -->
 <div>
 <div>
 <h4>
 🏷️ Categoria
 </h4>
 <div>
 <% if transaction.category.present? %>
 <span><%= transaction.category.name %></span>
 <% else %>
 <span>
 <%= transaction.transaction_type == 'transfer' ? 'N/A (Transferência)' : 'Não informado' %>
 </span>
 <% end %>
 </div>
 </div>
 </div>

 <!-- Status -->
 <div>
 <div>
 <h4>
 📊 Status
 </h4>
 <div>
 <span>
 <%= transaction.status == 'confirmed' ? '✅ Confirmado' : transaction.status == 'pending' ? '⏳ Pendente' : '❌ Cancelado' %>
 </span>
 </div>
 </div>
 </div>
 </div>

 <!-- Installment Info (if part of a plan) -->
 <% if transaction.installment_plan.present? %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
 </svg>
 <div>
 <h4>💳 Parcelamento</h4>
 <div>
 <p>Plano: <strong><%= transaction.installment_plan.name %></strong></p>
 <p>Parcela: <strong><%= transaction.installment_number %>/<%= transaction.installment_plan.installment_count %></strong></p>
 <div>
 <%= link_to 'Ver todas as parcelas', installment_plan_path(transaction.installment_plan), class: "link link-primary text-xs" %>
 </div>
 </div>
 </div>
 </div>
 <% end %>

 <!-- Recurring Commitment Info -->
 <% if transaction.recurring_commitment.present? %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
 </svg>
 <div>
 <h4>🔄 Compromisso Recorrente</h4>
 <div>
 <p>Compromisso: <strong><%= transaction.recurring_commitment.name %></strong></p>
 <p>Frequência: <strong><%= transaction.recurring_commitment.recurrence_frequency.humanize %></strong></p>
 <div>
 <%= link_to 'Ver compromisso', recurring_commitment_path(transaction.recurring_commitment), class: "link link-primary text-xs" %>
 </div>
 </div>
 </div>
 </div>
 <% end %>
 </div>

 <!-- Modal Footer -->
 <div>
 <div>
 ID: <%= transaction.id %>
 </div>
 <div>
 <%= link_to 'Editar', edit_transaction_path(transaction) %>
 <label for="transaction_modal" data-action="click->modal#hide">Fechar</label>
 </div>
 </div>
</div>
