<%# Partial para exibir tabela de transações %>
<% running_balance = 0 %>
<section class="transactions">
  <table>
    <thead>
      <tr>
        <th><%= t('ui.transaction.table.type') %></th>
        <th><%= t('ui.transaction.table.event') %></th>
        <th><%= t('ui.transaction.table.payment') %></th>
        <th><%= t('activerecord.attributes.transaction.description') %></th>
        <th><%= t('ui.transaction.table.origin') %></th>
        <th><%= t('ui.transaction.table.destination') %></th>
        <th><%= t('activerecord.attributes.transaction.category') %></th>
        <th><%= t('activerecord.attributes.transaction.amount') %></th>
        <th><%= t('ui.transaction.table.accumulated_balance') %></th>
        <th><%= t('ui.actions.title') %></th>
      </tr>
    </thead>
    <tbody>
 <% transactions.each do |tx| %>
 <% 
 case tx.transaction_type
 when 'income'
 delta = tx.amount
 when 'expense' 
 delta = -tx.amount
 when 'transfer'
 delta = 0 # Transfers don't affect overall balance
 else
 delta = 0
 end
 running_balance += delta 
 %>
      <tr class="<%= tx.transaction_type %>">
        <td class="type">
          <% case tx.transaction_type %>
          <% when 'income' %>
            <mark class="income"><%= t('ui.transaction.types.income') %></mark>
          <% when 'expense' %>
            <mark class="expense"><%= t('ui.transaction.types.expense') %></mark>
          <% when 'transfer' %>
            <mark class="transfer"><%= t('ui.transaction.types.transfer') %></mark>
          <% end %>
        </td>
        <td class="date"><%= l(tx.event_date) if tx.event_date %></td>
        <td class="date"><%= l(tx.payment_date) if tx.payment_date %></td>
        <td class="description">
          <div class="content">
            <strong><%= tx.description %></strong>
            <% if tx.installment_plan.present? %>
              <small class="meta">
                <%= "#{tx.installment_number}/#{tx.installment_plan.installment_count}" %> - <%= tx.installment_plan.name %>
              </small>
            <% elsif tx.recurring_commitment.present? %>
              <small class="meta">
                <%= tx.recurring_commitment.name %>
              </small>
            <% end %>
          </div>
          <% if tx.installment_plan.present? %>
            <span class="icon" title="<%= "#{t('ui.transaction.installments.tooltip')}: #{tx.installment_plan.name}" %>">⟳</span>
          <% elsif tx.recurring_commitment.present? %>
            <span class="icon" title="<%= "#{t('ui.transaction.recurring.tooltip')}: #{tx.recurring_commitment.name}" %>">↻</span>
          <% end %>
        </td>
        <td class="account">
          <% credit_entry = tx.entries.find { |e| e.entry_type == 'credit' } %>
          <%= credit_entry&.account&.name || 'N/A' %>
        </td>
        <td class="account">
          <% debit_entry = tx.entries.find { |e| e.entry_type == 'debit' } %>
          <%= debit_entry&.account&.name || 'N/A' %>
        </td>
        <td class="category">
          <% if tx.category.present? %>
            <%= tx.category.name %>
          <% else %>
            <span>—</span>
          <% end %>
        </td>
        <td class="amount <%= tx.transaction_type %>">
          <%= 
            case tx.transaction_type
            when 'transfer'
              "🔄 #{format_money_unified(tx.amount)}"
            else
              format_money_unified(tx.amount)
            end
          %>
        </td>
        <td class="balance <%= running_balance >= 0 ? 'positive' : 'negative' %>">
          <%= format_money_unified(running_balance) %>
        </td>
        <td class="actions">
          <button 
            data-action="click->modal#show" 
            data-url="<%= transaction_path(tx) %>"
            title="<%= t('ui.actions.show') %>">
            👁️
          </button>
          <%= link_to edit_transaction_path(tx), title: t('ui.actions.edit') do %>
            ✏️
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</section>
