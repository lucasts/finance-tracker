<div>
  <!-- Header -->
  <div>
    <div>
      <ul>
        <li><%= link_to "Importações", import_sessions_path, class: "link link-hover" %></li>
        <li>Arquivo Já Importado</li>
      </ul>
    </div>
    <h1>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Arquivo já foi importado anteriormente
    </h1>
  </div>

  <!-- Alert banner -->
  <div role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div>
      <p>
        O arquivo <strong><%= @import_session.original_filename %></strong> já foi processado em
        <%= l(@import_session.created_at, format: :long) %>.
        Nenhuma transação duplicada foi criada.
      </p>
    </div>
  </div>

  <!-- Dados da sessão original -->
  <div>
    <!-- Informações básicas -->
    <div>
      <div>
        <h2>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Informações da importação original
        </h2>
        <div>
          <div>
            <span>Arquivo:</span>
            <span><%= @import_session.original_filename %></span>
          </div>
          <div>
            <span>Tipo:</span>
            <div><%= @import_session.source_type.upcase %></div>
          </div>
          <div>
            <span>Conta:</span>
            <span><%= @import_session.account&.name %></span>
          </div>
          <div>
            <span>Importado em:</span>
            <span><%= l(@import_session.created_at, format: :long) %></span>
          </div>
          <% if @import_session.imported_at %>
            <div>
              <span>Finalizado em:</span>
              <span><%= l(@import_session.imported_at, format: :long) %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Estatísticas da sessão -->
    <div>
      <div>
        <h2>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          Resumo da sessão
        </h2>
        <div>
          <div>
            <span>Total de linhas:</span>
            <span><%= @imported_transactions.count %></span>
          </div>
          <div>
            <span>Conciliadas:</span>
            <span>
              <%= @imported_transactions.joins(:reconciliation_entry).where.not(reconciliation_entries: { action: nil }).count %>
            </span>
          </div>
          <div>
            <span>Pendentes:</span>
            <span>
              <%= @imported_transactions.left_joins(:reconciliation_entry).where(reconciliation_entries: { id: nil }).count %>
            </span>
          </div>
          <div>
            <span>Possíveis duplicadas:</span>
            <span><%= @imported_transactions.where(possible_duplicate: true).count %></span>
          </div>
          <div>
            <span>Transferências candidatas:</span>
            <span><%= @imported_transactions.where(transfer_candidate: true).count %></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Ações -->
  <div>
    <%= link_to import_session_path(@import_session) do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
      Ver sessão original
    <% end %>
    <%= link_to import_sessions_path do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
      </svg>
      Ver todas as importações
    <% end %>
    <%= link_to new_import_session_path do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
      </svg>
      Importar outro arquivo
    <% end %>
  </div>
</div>
