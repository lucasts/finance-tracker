<div>
 <!-- Header -->
 <div>
 <!-- Tabela de importações -->
 <div 
 data-controller="table-filter"
 data-table-filter-target="table">
 <div>
 <div>
 <table>
 <thead>
 <tr>
 <th>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />div>
 <h1>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
 </svg>
 Minhas Importações
 </h1>
 <p>Histórico de importações de extratos bancários</p>
 </div>
 <%= link_to new_import_session_path do %>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
 </svg>
 Nova Importação
 <% end %>
 </div>

 <% if @import_sessions.any? %>
 <!-- Estatísticas rápidas -->
 <div>
 <div>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
 </svg>
 </div>
 <div>Total de Importações</div>
 <div><%= @import_sessions.count %></div>
 <div>Arquivos processados</div>
 </div>
 
 <div>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
 </svg>
 </div>
 <div>Concluídas</div>
 <div><%= @import_sessions.where.not(imported_at: nil).count %></div>
 <div>Processamentos finalizados</div>
 </div>
 
 <div>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 </div>
 <div>Pendentes</div>
 <div><%= @import_sessions.where(imported_at: nil).count %></div>
 <div>Aguardando conciliação</div>
 </div>

 <div>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
 </svg>
 </div>
 <div>Esta Semana</div>
 <div><%= @import_sessions.where(created_at: 1.week.ago..Time.current).count %></div>
 <div>Novas importações</div>
 </div>
 </div>

 <!-- Filtros e busca -->
 <div>
 <div>
 <div>
 <div>
 <div>
 <input type="text" 
 placeholder="Buscar por nome do arquivo..." 
 
 id="search-input"
 data-table-filter-target="searchInput"
 data-action="input->table-filter#handleSearch">
 <span>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
 </svg>
 </span>
 </div>
 </div>
 <div>
 <select 
 id="status-filter" 
 data-table-filter-target="statusFilter"
 data-action="change->table-filter#handleStatusChange">
 <option value="">Todos os status</option>
 <option value="completed">Concluídas</option>
 <option value="pending">Pendentes</option>
 </select>
 </div>
 <div>
 <select 
 id="type-filter" 
 data-table-filter-target="typeFilter"
 data-action="change->table-filter#handleTypeChange">
 <option value="">Todos os tipos</option>
 <option value="OFX">OFX</option>
 <option value="CSV">CSV</option>
 </select>
 </div>
 </div>
 </div>
 </div>

 <!-- Tabela de importações -->
 <div>
 <div>
 <div>
 <table>
 <thead>
 <tr>
 <th>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
 </svg>
 Data
 </th>
 <th>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
 </svg>
 Arquivo
 </th>
 <th>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
 </svg>
 Conta
 </th>
 <th>Status</th>
 <th>Ações</th>
 </tr>
 </thead>
 <tbody>
 <% @import_sessions.each do |session| %>
 <tr 
 data-table-filter-target="row"
 data-filename="<%= session.original_filename.downcase %>"
 data-status="<%= session.imported_at ? 'completed' : 'pending' %>"
 data-type="<%= session.source_type.upcase %>">
 <td>
 <div>
 <span><%= l(session.created_at, format: :short) %></span>
 <span><%= time_ago_in_words(session.created_at) %> atrás</span>
 </div>
 </td>
 <td>
 <div>
 <div>
 <%= session.source_type.upcase %>
 </div>
 <span title="<%= session.original_filename %>">
 <%= session.original_filename %>
 </span>
 </div>
 </td>
 <td>
 <div>
 <div></div>
 <span><%= session.account&.name %></span>
 </div>
 </td>
 <td>
 <% if session.imported_at %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
 </svg>
 Concluída
 </div>
 <% else %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 Pendente
 </div>
 <% end %>
 </td>
 <td>
 <%= render 'action_buttons', session: session %>
 </td>
 </tr>
 <% end %>
 </tbody>
 </table>
 </div>
 </div>
 </div>
 <% else %>
 <!-- Estado vazio -->
 <div>
 <div>
 <div>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
 </svg>
 </div>
 <h1>Nenhuma importação ainda</h1>
 <p>
 Comece importando um extrato bancário para conciliar suas transações automaticamente.
 </p>
 <%= link_to new_import_session_path do %>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
 </svg>
 Fazer Primeira Importação
 <% end %>
 </div>
 </div>
 </div>
 <% end %>
</div>
