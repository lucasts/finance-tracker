<section class="import-session-show">
  <!-- Breadcrumbs -->
  <ul class="breadcrumbs">
    <li><%= link_to "Importações", import_sessions_path %></li>
    <li>Detalhes da Importação</li>
  </ul>

  <!-- Header -->
  <header class="page-header">
    <div class="header-left">
      <h1>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <%= @import_session.original_filename %>
      </h1>
    </div>
    <div>
      <% if @import_session.imported_at %>
        <span class="status-badge completed">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Concluída
        </span>
      <% else %>
        <span class="status-badge pending">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Pendente
        </span>
      <% end %>
    </div>
  </header>

  <!-- Cards de informação -->
  <div class="cards-grid">
    <!-- Informações básicas -->
    <article class="detail-card">
      <h2>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Informações
      </h2>
      <div>
        <div class="info-row">
          <span class="info-label">Tipo:</span>
          <span class="info-value"><span class="badge"><%= @import_session.source_type.upcase %></span></span>
        </div>
        <div class="info-row">
          <span class="info-label">Conta:</span>
          <span class="info-value"><%= @import_session.account&.name %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Importado em:</span>
          <span class="info-value"><%= l(@import_session.created_at, format: :short) %></span>
        </div>
        <% if @import_session.imported_at %>
          <div class="info-row">
            <span class="info-label">Finalizado em:</span>
            <span class="info-value"><%= l(@import_session.imported_at, format: :short) %></span>
          </div>
        <% end %>
        <div class="info-row">
          <span class="info-label">Tamanho:</span>
          <span class="info-value"><%= file_size_human(@import_session.file_size) %></span>
        </div>
      </div>
    </article>

    <!-- Estatísticas -->
    <article class="detail-card">
      <h2>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Estatísticas
      </h2>
      <div>
        <div class="info-row">
          <span class="info-label">Total de linhas:</span>
          <span class="info-value"><%= @imported_transactions.count %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Conciliadas:</span>
          <span class="info-value">
            <%= @imported_transactions.joins(:reconciliation_entry).where.not(reconciliation_entries: { action: nil }).count %>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">Pendentes:</span>
          <span class="info-value">
            <%= @imported_transactions.left_joins(:reconciliation_entry).where(reconciliation_entries: { id: nil }).count %>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">Possíveis duplicadas:</span>
          <span class="info-value">
            <%= @imported_transactions.where(possible_duplicate: true).count %>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">Transferências candidatas:</span>
          <span class="info-value">
            <%= @imported_transactions.where(transfer_candidate: true).count %>
          </span>
        </div>
      </div>
    </article>

    <!-- Progresso -->
    <article class="detail-card">
      <h2>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Progresso
      </h2>
      <%
        total = @imported_transactions.count
        conciliadas = @imported_transactions.joins(:reconciliation_entry).where.not(reconciliation_entries: { action: nil }).count
        progresso = total > 0 ? (conciliadas.to_f / total * 100).round : 0
      %>
      <div class="progress-section">
        <div class="progress-header">
          <span class="progress-label">Conciliação</span>
          <span class="progress-percentage"><%= progresso %>%</span>
        </div>
        <progress value="<%= progresso %>" max="100"></progress>
        <div class="progress-footer">
          <%= conciliadas %> de <%= total %> transações processadas
        </div>
      </div>
    </article>
  </div>

  <!-- Tabela de transações -->
  <section class="transactions-section">
    <div class="section-header">
      <h2>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        Transações Importadas
      </h2>
      <span class="record-count"><%= @imported_transactions.count %> registros</span>
    </div>

    <% if @imported_transactions.any? %>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Descrição</th>
              <th>Valor</th>
              <th>Data</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @imported_transactions.each do |tx| %>
              <tr>
                <td><%= tx.line_number %></td>
                <td>
                  <div class="tx-description" title="<%= tx.description %>">
                    <span class="description-text"><%= tx.description %></span>
                    <% if tx.possible_duplicate %>
                      <span class="tx-badge duplicate" title="Transação potencialmente duplicada com base em heurísticas de similaridade (valor/data)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-2.5L13.73 5c-.77-.83-1.96-.83-2.73 0L3.34 16.5c-.77.83.19 2.5 1.73 2.5z" />
                        </svg>
                        Suspeita de duplicata
                      </span>
                    <% end %>
                    <% if tx.transfer_candidate %>
                      <span class="tx-badge transfer" title="Possível transferência entre contas. Valor e data similares encontrados em outra conta.">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                        </svg>
                        Transferência candidata
                      </span>
                    <% end %>
                  </div>
                </td>
                <td>
                  <span class="tx-amount">
                    <%= tx.amount.nil? ? '-' : format_money(tx.amount) %>
                  </span>
                </td>
                <td>
                  <%= l(tx.event_date, format: :short) if tx.event_date %>
                </td>
                <td>
                  <% if tx.reconciliation_entry&.action == 'create_new' && tx.reconciliation_entry&.linked_transaction %>
                    <span class="tx-status created">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                      </svg>
                      Nova criada
                    </span>
                  <% elsif tx.reconciliation_entry&.action == 'associate' %>
                    <span class="tx-status associated">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                      </svg>
                      Associada
                    </span>
                  <% elsif tx.reconciliation_entry&.action == 'ignore' %>
                    <span class="tx-status ignored">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18.364 5.636M5.636 18.364l12.728-12.728" />
                      </svg>
                      Ignorada
                    </span>
                  <% else %>
                    <span class="tx-status pending-status">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Pendente
                    </span>
                  <% end %>
                </td>
                <td class="tx-action">
                  <% if tx.reconciliation_entry&.linked_transaction %>
                    <%= link_to transaction_path(tx.reconciliation_entry.linked_transaction),
                        title: "Ver transação criada/associada" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                      Ver
                    <% end %>
                  <% else %>
                    <%= link_to edit_import_session_imported_transaction_path(@import_session, tx),
                        title: "Conciliar transação" do %>
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                      Conciliar
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h3>Nenhuma transação importada</h3>
        <p>Não foram encontradas transações neste arquivo de importação.</p>
      </div>
    <% end %>
  </section>

  <!-- Footer com ações -->
  <footer class="page-actions">
    <%= link_to import_sessions_path do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
      </svg>
      Voltar às Importações
    <% end %>

    <%
      total_transactions = @imported_transactions.count
      reconciled_transactions = @imported_transactions.joins(:reconciliation_entry).where.not(reconciliation_entries: { action: nil }).count
      pending_transactions = total_transactions - reconciled_transactions
      has_pending = pending_transactions > 0
    %>

    <% if has_pending %>
      <div class="status-alert warning">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z"/>
        </svg>
        <span>
          <strong>Atenção:</strong> <%= pending_transactions %> transação(ões) pendente(s) de conciliação.
        </span>
      </div>
    <% elsif !@import_session.imported_at %>
      <div class="status-alert info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span>
          <strong>Pronto!</strong> Todas as transações foram conciliadas. Pode finalizar a importação.
        </span>
      </div>
    <% end %>

    <% if !has_pending && !@import_session.imported_at %>
      <%= link_to confirm_import_session_path(@import_session), class: "primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Finalizar Importação
      <% end %>
    <% end %>
  </footer>
</section>
