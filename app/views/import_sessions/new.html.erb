<div class="container mx-auto max-w-2xl px-4 py-8">
  <!-- Header -->
  <div class="text-center mb-8">
    <h1 class="text-3xl font-bold text-base-content mb-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 inline-block mr-2 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
      </svg>
      Nova Importação de Extrato
    </h1>
    <p class="text-base-content/70">Importe extratos bancários em formato OFX ou CSV para conciliação automática</p>
  </div>

  <!-- Card principal -->
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <%= form_with model: @import_session, url: import_sessions_path, local: true, html: { multipart: true, class: "space-y-6" } do |f| %>
        
        <!-- Tipo de arquivo -->
        <div class="form-control">
          <%= f.label :source_type, class: "label" do %>
            <span class="label-text font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Tipo de arquivo
            </span>
          <% end %>
          <%= f.select :source_type, 
              [['OFX (Open Financial Exchange)', 'ofx'], ['CSV (Comma Separated Values)', 'csv']], 
              { prompt: 'Selecione o tipo de arquivo...' }, 
              { class: "select select-bordered w-full", required: true } %>
          <div class="label">
            <span class="label-text-alt text-base-content/60">OFX é o formato padrão dos bancos. CSV requer mapeamento de campos.</span>
          </div>
        </div>

        <!-- Conta destino -->
        <div class="form-control">
          <%= f.label :account_id, class: "label" do %>
            <span class="label-text font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
              Conta destino
            </span>
          <% end %>
          <%= f.collection_select :account_id, 
              current_user.accounts, :id, :name, 
              { prompt: 'Selecione a conta...' }, 
              { class: "select select-bordered w-full", required: true } %>
          <div class="label">
            <span class="label-text-alt text-base-content/60">Conta onde as transações serão importadas</span>
          </div>
        </div>

        <!-- Upload do arquivo -->
        <div class="form-control">
          <%= f.label :file, class: "label" do %>
            <span class="label-text font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
              </svg>
              Arquivo de extrato
            </span>
          <% end %>
          <div class="file-input-wrapper">
            <%= f.file_field :file, 
                class: "file-input file-input-bordered w-full", 
                accept: ".ofx,.csv,.txt", 
                required: true,
                onchange: "updateFilePreview(this)" %>
          </div>
          <div class="label">
            <span class="label-text-alt text-base-content/60">Formatos aceitos: .ofx, .csv, .txt (máx. 10MB)</span>
          </div>
          <!-- Preview do arquivo selecionado -->
          <div id="file-preview" class="hidden mt-2 p-3 bg-primary/5 border border-primary/20 rounded-lg">
            <div class="flex items-center gap-2 text-sm text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span id="file-name"></span>
              <span id="file-size" class="text-xs text-base-content/60"></span>
            </div>
          </div>
        </div>

        <!-- Info card -->
        <div class="alert alert-info">
          <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <h3 class="font-bold">Dica</h3>
            <div class="text-xs">
              <p>• <strong>OFX:</strong> Baixe diretamente do seu banco (mais preciso)</p>
              <p>• <strong>CSV:</strong> Exporte do Excel ou sistema bancário</p>
              <p>• Exemplo de CSV disponível <%= link_to "aqui", "/import_example.csv", class: "link link-primary", target: "_blank" %></p>
            </div>
          </div>
        </div>

        <!-- Botões de ação -->
        <div class="card-actions justify-between">
          <%= link_to "Cancelar", import_sessions_path, class: "btn btn-ghost" %>
          <%= f.submit "Iniciar Importação", 
              class: "btn btn-primary gap-2", 
              data: { 
                confirm: "Confirma a importação do arquivo selecionado?",
                loading: "Processando arquivo..."
              },
              onclick: "this.classList.add('loading'); this.disabled = true; setTimeout(() => this.form.submit(), 100);" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Link de volta -->
  <div class="text-center mt-6">
    <%= link_to import_sessions_path, class: "link link-hover text-base-content/70" do %>
      ← Voltar para importações
    <% end %>
  </div>
</div>

<script>
function updateFilePreview(input) {
  const preview = document.getElementById('file-preview');
  const fileName = document.getElementById('file-name');
  const fileSize = document.getElementById('file-size');
  
  if (input.files && input.files[0]) {
    const file = input.files[0];
    fileName.textContent = file.name;
    fileSize.textContent = `(${(file.size / 1024 / 1024).toFixed(2)} MB)`;
    preview.classList.remove('hidden');
  } else {
    preview.classList.add('hidden');
  }
}
</script>
