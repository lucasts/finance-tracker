<section class="form-page">
  <header class="form-header">
    <h1>Nova Importação de Extrato</h1>
    <p>Importe extratos bancários em formato OFX ou CSV para conciliação automática</p>
  </header>

  <%= form_with model: @import_session, url: import_sessions_path, local: true, html: { multipart: true, class: "form", role: "form", "aria-label" => "Formulário de importação de extrato bancário" } do |f| %>
    <% if @import_session.errors.any? %>
      <article class="form-errors">
        <h2><%= pluralize(@import_session.errors.count, "erro") %> <%= @import_session.errors.count == 1 ? "impediu" : "impediram" %> a importação:</h2>
        <ul>
          <% @import_session.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </article>
    <% end %>

    <fieldset class="form-fieldset">
      <div class="form-field">
        <%= f.label :source_type, "Tipo de arquivo" %>
        <%= f.select :source_type,
            [['OFX (Open Financial Exchange)', 'ofx'], ['CSV (Comma Separated Values)', 'csv']],
            { prompt: 'Selecione o tipo de arquivo...' },
            { id: "import_session_source_type", required: true } %>
        <small>OFX é o formato padrão dos bancos. CSV requer mapeamento de campos.</small>
      </div>

      <div class="form-field">
        <%= f.label :account_id, "Conta destino" %>
        <%= f.collection_select :account_id,
            current_user.accounts, :id, :name,
            { prompt: 'Selecione a conta...' },
            { id: "import_session_account_id", required: true } %>
        <small>Conta onde as transações serão importadas</small>
      </div>

      <div class="form-field">
        <%= f.label :file, "Arquivo de extrato" %>
        <div data-controller="file-upload"
             data-file-upload-allowed-types-value='[".ofx", ".csv", ".txt"]'
             data-file-upload-max-size-value="10485760"
             data-file-upload-show-preview-value="true">
          <%= f.file_field :file,
              id: "import_session_file",
              accept: ".ofx,.csv,.txt",
              required: true,
              data: { file_upload_target: "input" } %>
          <div data-file-upload-target="preview" role="status" aria-live="polite"></div>
          <div data-file-upload-target="error" role="alert" aria-live="assertive"></div>
        </div>
        <small>Formatos aceitos: .ofx, .csv, .txt (máx. 10MB)</small>
      </div>
    </fieldset>

    <aside class="form-tip">
      <h3>Dica</h3>
      <p><strong>OFX:</strong> Baixe diretamente do seu banco (mais preciso)</p>
      <p><strong>CSV:</strong> Exporte do Excel ou sistema bancário</p>
      <p>Exemplo de CSV disponível <%= link_to "aqui", "/import_example.csv", target: "_blank" %></p>
    </aside>

    <footer class="form-actions">
      <%= f.submit "Iniciar Importação", class: "btn-primary",
          data: {
            confirm: "Confirma a importação do arquivo selecionado?",
            loading: "Processando arquivo...",
            file_upload_target: "submit",
            action: "click->file-upload#handleSubmit"
          } %>
      <%= link_to "Cancelar", import_sessions_path, class: "btn-secondary" %>
    </footer>
  <% end %>
</section>
