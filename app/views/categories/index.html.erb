<h1><%= t('activerecord.models.category.other') %></h1>

<div> <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.category.one'), new_category_path %>
</div>

<div>
 <div>
 <table>
 <thead>
 <tr>
 <th><%= t('activerecord.attributes.category.name') %></th>
 <th>Descrição</th>
 <th><%= t('activerecord.attributes.category.category_type') %></th>
 <th><%= t('ui.actions.title') %></th>
 </tr>
 </thead>
 <tbody>
 <% @categories.each do |cat| %>
 <tr>
 <td><strong><%= cat.name %></strong></td>
 <td>
 <%= cat.description.present? ? truncate(cat.description, length: 80) : "—" %>
 </td>
 <td>
 <% if cat.income? %>
 <span>📈 <%= t('ui.transaction.types.income') %></span>
 <% else %>
 <span>📉 <%= t('ui.transaction.types.expense') %></span>
 <% end %>
 </td>
 <td>
 <%= link_to t('ui.actions.edit'), edit_category_path(cat) %>
 </td>
 </tr>
 <% end %>
 </tbody>
 </table>
 </div>
</div>