<h1 class="text-3xl font-bold mb-6">Categorias</h1>

<div class="flex justify-between items-center mb-4">  <%= link_to 'Nova Categoria', new_category_path, class: "btn btn-primary" %>
</div>

<div class="bg-base-100 rounded-box shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead class="bg-base-200">
        <tr>
          <th>Nome</th>
          <th class="text-right">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |cat| %>
          <tr>
            <td><%= cat.name %></td>
            <td class="text-right">
              <%= link_to 'Editar', edit_category_path(cat), class: "link link-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>