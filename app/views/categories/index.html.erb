<section class="index-page">
  <header class="page-header">
    <h1><%= t('activerecord.models.category.other') %></h1>
    <%= link_to new_category_path, class: "btn-new", title: t('ui.actions.new') + ' ' + t('activerecord.models.category.one') do %>
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path>
      </svg>
    <% end %>
  </header>

  <% if @categories.any? %>
    <article class="data-table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Tipo</th>
            <th class="actions-column"><%= t('ui.actions.title') %></th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td class="category-name"><%= category.name %></td>
              <td class="category-description">
                <%= category.description.present? ? truncate(category.description, length: 80) : '—' %>
              </td>
              <td>
                <span class="category-type-badge <%= category.category_type %>">
                  <%= t("ui.transaction.types.#{category.category_type}") %>
                </span>
              </td>
              <td class="actions-column">
                <%= link_to edit_category_path(category), class: "btn-action", title: t('ui.actions.edit') do %>
                  <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
                  </svg>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </article>
  <% else %>
    <article class="empty-state">
      <div class="icon">🏷️</div>
      <h3>Nenhuma categoria cadastrada</h3>
      <p>Crie categorias para organizar suas receitas e despesas.</p>
      <footer>
        <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.category.one'), new_category_path, class: "btn-primary" %>
      </footer>
    </article>
  <% end %>
</section>
