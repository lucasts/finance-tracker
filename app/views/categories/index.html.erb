<h1 class="text-3xl font-bold mb-6"><%= t('activerecord.models.category.other') %></h1>

<div class="flex justify-between items-center mb-4">  <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.category.one'), new_category_path, class: "btn btn-primary" %>
</div>

<div class="bg-base-100 rounded-box shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead class="bg-base-200">
        <tr>
          <th><%= t('activerecord.attributes.category.name') %></th>
          <th class="text-right"><%= t('ui.actions.title') %></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |cat| %>
          <tr>
            <td><%= cat.name %></td>
            <td class="text-right">
              <%= link_to t('ui.actions.edit'), edit_category_path(cat), class: "link link-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>