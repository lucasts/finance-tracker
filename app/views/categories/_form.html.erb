<%= form_with(model: category, local: true) do |form| %>
 <div>
 <%= form_group(form, :name) %>
 
 <div>
 <label>
 <span>📝 Descrição (opcional)</span>
 </label>
 <%= form.text_area :description, class: "textarea textarea-bordered", placeholder: "Descreva o tipo de gasto ou receita desta categoria...", rows: 3 %>
 <label>
 <span>Máximo 500 caracteres</span>
 </label>
 </div>
 
 <div>
 <label>
 <span>💰 <%= t('activerecord.attributes.category.category_type') %></span>
 </label>
 <div>
 <%= form.radio_button :category_type, "income", class: "radio radio-success" %>
 <%= form.label :category_type_income, "📈 #{t('ui.transaction.types.income')}", class: "cursor-pointer flex items-center gap-2" %>
 
 <%= form.radio_button :category_type, "expense", class: "radio radio-error ml-6" %>
 <%= form.label :category_type_expense, "📉 #{t('ui.transaction.types.expense')}", class: "cursor-pointer flex items-center gap-2" %>
 </div>
 </div>
 
 <%= primary_button("Salvar") %>
 </div>
<% end %>