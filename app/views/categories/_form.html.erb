<%= form_with(model: category, local: true, class: "form") do |form| %>
  <% if category.errors.any? %>
    <article class="form-errors">
      <h2><%= pluralize(category.errors.count, "erro") %> <%= category.errors.count == 1 ? "impediu" : "impediram" %> que esta categoria fosse salva:</h2>
      <ul>
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </article>
  <% end %>

  <fieldset class="form-fieldset">
    <div class="form-field">
      <%= form.label :name, "Nome da Categoria" %>
      <%= form.text_field :name, placeholder: "Ex: Alimentação, Salário, Transporte", autofocus: true %>
    </div>

    <div class="form-field">
      <%= form.label :description, "Descrição (opcional)" %>
      <%= form.text_area :description, 
          placeholder: "Descreva o tipo de gasto ou receita desta categoria...", 
          rows: 3 %>
      <small style="color: var(--color-text-muted); font-size: var(--font-size-xs);">Máximo 500 caracteres</small>
    </div>

    <div class="form-field">
      <%= form.label :category_type, t('activerecord.attributes.category.category_type') %>
      <div class="radio-group">
        <label class="radio-option">
          <%= form.radio_button :category_type, "income" %>
          <span><%= t('ui.transaction.types.income') %></span>
        </label>
        
        <label class="radio-option">
          <%= form.radio_button :category_type, "expense" %>
          <span><%= t('ui.transaction.types.expense') %></span>
        </label>
      </div>
    </div>
  </fieldset>

  <footer class="form-actions">
    <%= form.submit "Salvar Categoria", class: "btn-primary" %>
    <%= link_to "Cancelar", categories_path, class: "btn-secondary" %>
  </footer>
<% end %>