<h1>💳 Fatura do Cartão</h1>

<!-- Header Info Card -->
<div>
 <div>
 <div>
 <div>
 <h2><%= @credit_statement.account.name %></h2>
 <p>Fatura de <%= @credit_statement.month %></p>
 </div>
 <div>
 <span>
 <%= t("activerecord.attributes.credit_statement.statuses.#{@credit_statement.status}") rescue @credit_statement.status.titleize %>
 </span>
 </div>
 </div>
 </div>
</div>

<!-- Financial Summary Cards -->
<div>
 <div>
 <div>
 <label>Valor Total da Fatura</label>
 <p>R$ <%= number_with_precision(@credit_statement.amount_due, precision: 2, separator: ",") %></p>
 </div>
 </div>
 
 <div>
 <div>
 <label>Valor Pago</label>
 <p>R$ <%= number_with_precision(@credit_statement.amount_paid, precision: 2, separator: ",") %></p>
 </div>
 </div>
 
 <div>
 <div>
 <label>Saldo Restante</label>
 <p>R$ <%= number_with_precision(@credit_statement.remaining_balance, precision: 2, separator: ",") %></p>
 </div>
 </div>
</div>

<!-- Detailed Information -->
<div>
 <!-- Dates and Timeline -->
 <div>
 <div>
 <h3>📅 Cronograma</h3>
 <div>
 <div>
 <span>Data de Fechamento</span>
 <span>
 <%= l(@credit_statement.closed_on, format: :long) if @credit_statement.closed_on %>
 <% unless @credit_statement.closed_on %>
 <span>Não informado</span>
 <% end %>
 </span>
 </div>
 
 <div>
 <span>Data de Vencimento</span>
 <span>
 <%= l(@credit_statement.due_on, format: :long) if @credit_statement.due_on %>
 <% unless @credit_statement.due_on %>
 <span>Não informado</span>
 <% end %>
 </span>
 </div>
 
 <div>
 <span>Data de Pagamento</span>
 <span>
 <%= l(@credit_statement.paid_on, format: :long) if @credit_statement.paid_on %>
 <% unless @credit_statement.paid_on %>
 <span>Não pago</span>
 <% end %>
 </span>
 </div>
 </div>
 </div>
 </div>
 
 <!-- Payment Status and Actions -->
 <div>
 <div>
 <h3>💰 Status do Pagamento</h3>
 
 <!-- Progress Bar -->
 <div>
 <div>
 <span>Progresso do Pagamento</span>
 <span>
 <% if @credit_statement.amount_due > 0 %>
 <%= number_to_percentage((@credit_statement.amount_paid / @credit_statement.amount_due) * 100, precision: 1) %>
 <% else %>
 0.0%
 <% end %>
 </span>
 </div>
 <progress 
 value="<%= @credit_statement.amount_paid %>" 
 max="<%= [@credit_statement.amount_due, 1].max %>"></progress>
 </div>
 
 <!-- Status Info -->
 <div>
 <% if @credit_statement.status == 'paid' %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
 <span>Fatura paga integralmente!</span>
 </div>
 <% elsif @credit_statement.status == 'overdue' %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z" /></svg>
 <span>Fatura em atraso!</span>
 </div>
 <% else %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16c-.77.833.192 2.5 1.732 2.5z" /></svg>
 <span>Aguardando pagamento</span>
 </div>
 <% end %>
 </div>
 </div>
 </div>
</div>

<!-- Actions -->
<div>
 <%= link_to '← Voltar às Faturas', credit_statements_path %>
 <% if respond_to?(:edit_credit_statement_path) %>
 <%= link_to 'Editar Fatura', edit_credit_statement_path(@credit_statement) %>
 <% end %>
</div>