<nav class="navbar bg-base-100 px-4 shadow-md">
  <div class="flex-1">
    <%= link_to overview_index_path, class: "btn btn-ghost normal-case text-xl flex items-center gap-2" do %>
      <%= image_tag "logo-min.png", alt: "Orzeny", class: "h-8 w-auto" %>
      <span class="font-bold text-primary"><%= t('app.name') %></span>
    <% end %>
  </div>
  <div class="flex-none">
    <% if user_signed_in? %>
      <ul class="menu menu-horizontal px-1">
        <li><%= link_to t('ui.navigation.overview'), overview_index_path %></li>
        <li><%= link_to t('ui.navigation.transactions'), transactions_path %></li>
        <li data-controller="dropdown">
          <details data-dropdown-target="menu" class="dropdown">
            <summary class="cursor-pointer"><%= t('ui.navigation.settings') %></summary>
            <ul class="p-2 shadow menu dropdown-content z-[1] bg-base-100 rounded-box w-52 border border-base-300 mt-1">
              <li><%= link_to t('ui.navigation.accounts'), accounts_path %></li>
              <li><%= link_to t('ui.navigation.categories'), categories_path %></li>
              <li><%= link_to t('ui.navigation.account_types'), account_types_path %></li>
              <li><%= link_to t('ui.navigation.installment_plans'), installment_plans_path %></li>
              <li><%= link_to t('ui.navigation.recurring_commitments'), recurring_commitments_path %></li>
            </ul>
          </details>
        </li>
        <li><%= link_to t('ui.navigation.reports'), reports_path %></li>
        <li><%= link_to t('ui.navigation.credit_statements'), credit_statements_path %></li>
        <li><%= link_to "🤖 Automação", automation_index_path %></li>
        <li>
          <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.transaction.one'), new_transaction_path, class: "btn btn-primary btn-sm ml-2" %>
        </li>
        <li><%= link_to 'Importação', import_sessions_path %></li>
      </ul>
      <div class="dropdown dropdown-end ml-4">
        <label tabindex="0" class="btn btn-ghost btn-circle avatar">
          <div class="w-8 rounded-full bg-primary text-primary-content flex items-center justify-center">
            <%= current_user.email.first.upcase %>
          </div>
        </label>
        <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52">
          <li class="menu-title">
            <span><%= current_user.email %></span>
          </li>
          <li>
            <%= link_to edit_user_registration_path do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              Editar Perfil
            <% end %>
          </li>
          <li>
            <%= link_to destroy_user_session_path, data: { 'turbo-method': :delete } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
              </svg>
              Sair
            <% end %>
          </li>
        </ul>
      </div>
    <% else %>
      <div class="flex gap-2">
        <%= link_to "Entrar", new_user_session_path, class: "btn btn-ghost" %>
        <%= link_to "Registrar", new_user_registration_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</nav>
