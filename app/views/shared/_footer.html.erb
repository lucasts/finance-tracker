<footer class="site-footer" aria-label="Informações institucionais">
  <section class="footer-inner">
    <figure class="footer-branding">
      <%= image_tag "logo-min.png", alt: "Orzeny", class: "footer-logo" %>
      <figcaption>
        <strong><%= t('app.name') %></strong>
        <small><%= t('app.taglines.footer') %></small>
      </figcaption>
    </figure>

    <section class="footer-meta" aria-label="Créditos do produto">
      <p>© <%= Time.current.year %> Orzeny Tecnologia Financeira</p>
      <p>Desenvolvido no Brasil</p>
    </section>
  </section>
</footer>
