<% if notice %>
  <div class="flash-toast flash-success"
       data-controller="dismissible"
       data-dismissible-auto-hide-value="true"
       data-dismissible-hide-after-value="5000"
       data-dismissible-animate-value="true">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="flash-icon"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <span class="flash-text"><%= notice.html_safe %></span>
    <button type="button" class="flash-close" data-action="click->dismissible#dismiss" aria-label="Fechar alerta">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="flash-close-icon"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
<% end %>

<% if alert %>
  <div class="flash-toast flash-error"
       data-controller="dismissible"
       data-dismissible-animate-value="true">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="flash-icon"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <span class="flash-text"><%= alert %></span>
    <button type="button" class="flash-close" data-action="click->dismissible#dismiss" aria-label="Fechar alerta">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="flash-close-icon"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </div>
<% end %>
