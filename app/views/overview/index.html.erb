<% content_for :title, "Dashboard Financeiro" %>
<% content_for :description, "#{t('app.name')} - #{t('app.tagline')} Dashboard completo com visão de receitas, despesas e fluxo de caixa." %>

<div class="overview-page">
<nav class="month-navigation">
  <div class="navigation-row">
    <%= link_to overview_index_path(month: @prev_month), class: "month-nav-btn" do %>
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    <% end %>
    
    <div class="current-period">
      <h1>Dashboard</h1>
      <span class="month-label"><%= @selected_month_long %></span>
    </div>
    
    <%= link_to overview_index_path(month: @next_month), class: "month-nav-btn" do %>
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    <% end %>
    
    <% if @income_total > 0 || @expense_total > 0 %>
      <div class="financial-metrics">
        <div class="metric income">
          <span class="metric-label">Receitas</span>
          <data class="metric-value"><%= format_money(@income_total) %></data>
        </div>
        <div class="metric expense">
          <span class="metric-label">Despesas</span>
          <data class="metric-value"><%= format_money(@expense_total) %></data>
        </div>
        <div class="metric balance">
          <span class="metric-label">Saldo</span>
          <data class="metric-value <%= @balance >= 0 ? 'positive' : 'negative' %>"><%= format_money(@balance) %></data>
        </div>
      </div>
    <% end %>
  </div>
</nav>

<section class="chart-section">
  <header>
    <h2>Evolução Financeira</h2>
  </header>
  <div
    data-controller="chart"
    data-chart-options-value="<%= @chart_options.to_json %>"
    data-chart-target="container"
    style="min-height: 350px;">
  </div>
</section>

<section class="overview-details">
  <!-- Left Column -->
  <div>
    <!-- Accounts Summary -->
    <article class="accounts-overview">
      <header>
        <h3>Minhas Contas</h3>
        <%= link_to "Ver todas", accounts_path, class: "link-secondary" %>
      </header>
      <% if @accounts.any? %>
        <div class="accounts-list">
          <% @accounts.each do |account| %>
            <div class="account-item">
              <div class="account-info">
                <span class="account-name"><%= account.name %></span>
                <span class="account-type"><%= account.account_type.name %></span>
              </div>
              <data class="account-balance <%= @account_balances[account.id] >= 0 ? 'positive' : 'negative' %>">
                R$ <%= number_with_precision(@account_balances[account.id] || 0, precision: 2, delimiter: ".") %>
              </data>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <p>Nenhuma conta cadastrada</p>
          <%= link_to 'Criar primeira conta', new_account_path %>
        </div>
      <% end %>
    </article>

    <!-- Projected Balance -->
    <article class="projected-balance-overview">
      <header>
        <h3>Saldo Projetado</h3>
        <span class="projection-hint" title="Projeção baseada em transações confirmadas, compromissos recorrentes e parcelas futuras.">🔮</span>
      </header>
      <div class="projected-balance-value">
        <data class="<%= @projected_balance >= 0 ? 'positive' : 'negative' %>">
          <%= format_money(@projected_balance) %>
        </data>
      </div>
      <% if @balance_alert %>
        <div class="balance-alert">
          <span><%= @balance_alert %></span>
        </div>
      <% end %>
    </article>
  </div>

  <!-- Right Column -->
  <div>
    <!-- Upcoming Commitments (including projected transactions) -->
    <article class="commitments-overview">
      <header>
        <h3>Próximos Compromissos</h3>
      </header>
      <% combined_commitments = (@upcoming.to_a + @projected_transactions.map { |p| OpenStruct.new(description: p[:description], event_date: p[:date], amount: p[:amount]) }).sort_by(&:event_date).take(6) %>
      <% if combined_commitments.any? %>
        <div class="commitments-list">
          <% combined_commitments.each do |item| %>
            <div class="commitment-item">
              <div class="commitment-info">
                <span class="commitment-title"><%= item.description %></span>
                <time class="commitment-date"><%= l(item.event_date, format: :short) %></time>
              </div>
              <data class="commitment-amount">R$ <%= number_with_precision(item.amount, precision: 2, delimiter: ".") %></data>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <p>Nenhum compromisso próximo</p>
        </div>
      <% end %>
    </article>

    <!-- Credit Card Statements -->
    <article class="credit-statements">
      <header>
        <h3>Faturas do Cartão</h3>
        <%= link_to "Ver todas", credit_statements_path, class: "link-secondary" %>
      </header>
      <% if @credit_statements.any? %>
        <div class="statements-list">
          <% @credit_statements.each do |statement| %>
            <%= link_to credit_statement_path(statement), class: "statement-item" do %>
              <div class="statement-main">
                <div class="statement-identity">
                  <h4 class="card-name"><%= statement.account.name %></h4>
                  <span class="status-indicator <%= statement.status %>"></span>
                </div>
                <div class="statement-amounts">
                  <data class="amount-primary"><%= format_money(statement.amount_due) %></data>
                  <time class="due-date"><%= l(statement.due_on, format: "%d/%m") %></time>
                </div>
              </div>
              <% if statement.amount_due > statement.amount_paid %>
                <div class="statement-progress">
                  <div class="progress-info">
                    <span class="paid-label">Pago <%= format_money(statement.amount_paid) %></span>
                    <span class="remaining-label">Falta <%= format_money(statement.amount_due - statement.amount_paid) %></span>
                  </div>
                  <div class="progress-bar">
                    <div class="progress-fill" style="width: <%= ((statement.amount_paid / statement.amount_due) * 100).round %>%"></div>
                  </div>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <p>Nenhuma fatura de cartão para este mês</p>
        </div>
      <% end %>
    </article>
  </div>
</section>

<!-- Category Projections -->
<% if @category_projections.present? %>
<section class="category-projections-section">
  <article class="category-projections-overview">
    <header>
      <h3>Projeção por Categoria</h3>
      <span class="projection-hint" title="Média de gastos dos últimos 3 meses por categoria, comparada com o mês atual.">🔮</span>
    </header>
    <div class="category-projections-list">
      <% @category_projections.each do |proj| %>
        <div class="category-projection-item">
          <div class="category-projection-info">
            <span class="category-projection-name"><%= proj[:category].name %></span>
            <div class="category-projection-bar">
              <div class="category-projection-fill" style="width: <%= [proj[:percentage_used], 100].min %>%"></div>
            </div>
          </div>
          <div class="category-projection-amounts">
            <data class="category-spent"><%= format_money(proj[:current_spent]) %></data>
            <span class="category-projected-label">de <%= format_money(proj[:projected]) %></span>
          </div>
        </div>
      <% end %>
    </div>
  </article>
</section>
<% end %>
</div>
