<h1 class="text-2xl font-bold mb-6">Tipos de Conta</h1>
<p class="text-sm text-gray-600 mb-4">Gerencie os tipos de conta disponíveis no sistema.</p>
<%= link_to 'Novo Tipo de Conta', new_account_type_path, class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 mb-4 inline-block" %>

<table class="w-full bg-white shadow rounded text-sm">
  <thead class="bg-gray-100 text-gray-600">
    <tr>
      <th class="p-2 text-left">Código</th>
      <th class="p-2 text-left">Nome</th>
      <th class="p-2 text-left">Papel</th>
      <th class="p-2 text-right">Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @account_types.each do |type| %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-2"><%= type.code %></td>
        <td class="p-2"><%= type.name %></td>
        <td class="p-2"><%= type.role %></td>
        <td class="p-2 text-right">
          <%= link_to 'Editar', edit_account_type_path(type), class: "text-blue-600 hover:underline" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
