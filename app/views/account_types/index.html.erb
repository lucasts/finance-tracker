<h1><%= t('activerecord.models.account_type.other') %></h1>
<p><%= t('ui.account_type.index.description') %></p>

<div> <%= link_to t('ui.actions.new') + ' ' + t('activerecord.models.account_type.one'), new_account_type_path %>
</div>

<div>
 <div>
 <table>
 <thead>
 <tr>
 <th><%= t('activerecord.attributes.account_type.code') %></th>
 <th><%= t('activerecord.attributes.account_type.name') %></th>
 <th><%= t('activerecord.attributes.account_type.role') %></th>
 <th><%= t('ui.actions.title') %></th>
 </tr>
 </thead>
 <tbody>
 <% @account_types.each do |type| %>
 <tr>
 <td><%= type.code %></td>
 <td><%= type.name %></td>
 <td><%= type.role %></td>
 <td>
 <%= link_to 'Editar', edit_account_type_path(type), class: "link link-primary" %>
 </td>
 </tr>
 <% end %>
 </tbody>
 </table>
 </div>
</div>
