<h1 class="text-3xl font-bold mb-6">Tipos de Conta</h1>
<p class="text-sm text-base-content/60 mb-4">Gerencie os tipos de conta disponíveis no sistema.</p>

<div class="flex justify-between items-center mb-4">  <%= link_to 'Novo Tipo de Conta', new_account_type_path, class: "btn btn-primary" %>
</div>

<div class="bg-base-100 rounded-box shadow overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead class="bg-base-200">
        <tr>
          <th>Código</th>
          <th>Nome</th>
          <th>Papel</th>
          <th class="text-right">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @account_types.each do |type| %>
          <tr>
            <td><%= type.code %></td>
            <td><%= type.name %></td>
            <td><%= type.role %></td>
            <td class="text-right">
              <%= link_to 'Editar', edit_account_type_path(type), class: "link link-primary" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
