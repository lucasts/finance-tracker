<section class="installment-plans-index">
  <header class="page-header">
    <h1>Planos de Parcelamento</h1>
    <%= link_to new_installment_plan_path, class: "btn-new", title: "Novo Plano de Parcelamento" do %>
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path>
      </svg>
    <% end %>
  </header>

<% if @installment_plans.any? %>
 <div class="plans-list">
 <% @plan_summaries.each do |summary| %>
 <% plan = summary[:plan] %>
 <div class="plan-card">
 <div class="plan-header">
 <div>
 <h3><%= plan.name %></h3>
 </div>
 <div class="plan-status">
 <%= plan.active? ? 'Ativo' : 'Inativo' %>
 </div>
 </div>
 
 <!-- Progress Bar -->
 <div class="progress-section">
 <div>
 <span>Progresso</span>
 <span><%= summary[:progress_percentage] %>%</span>
 </div>
 <progress value="<%= summary[:progress_percentage] %>" max="100"></progress>
 <div>
 <%= summary[:paid_installments] %>/<%= plan.installment_count %> parcelas pagas
 </div>
 </div>
 
 <!-- Financial Summary -->
 <div class="financial-row">
 <div>
 <div>Valor Total</div>
 <div>R$ <%= number_with_precision(plan.total_amount, precision: 2, delimiter: ".") %></div>
 </div>
 <div>
 <div>Por Parcela</div>
 <div>R$ <%= number_with_precision(plan.installment_amount, precision: 2, delimiter: ".") %></div>
 </div>
 </div>
 
 <div class="financial-row">
 <div>
 <div>Pago</div>
 <div>R$ <%= number_with_precision(summary[:total_paid], precision: 2, delimiter: ".") %></div>
 </div>
 <div>
 <div>Restante</div>
 <div>R$ <%= number_with_precision(summary[:remaining_amount], precision: 2, delimiter: ".") %></div>
 </div>
 </div>
 
 <!-- Next Payment -->
 <% if summary[:next_due_date] %>
 <div class="next-payment-alert">
 <div>
 <strong>Próxima parcela:</strong>
 <%= l(summary[:next_due_date], format: :short) %>
 <span>
 <% days_diff = (summary[:next_due_date] - Date.current).to_i %>
 <% if days_diff == 0 %>
 Hoje
 <% elsif days_diff == 1 %>
 Amanhã
 <% elsif days_diff > 0 %>
 Em <%= days_diff %> dias
 <% else %>
 <%= days_diff.abs %> dias em atraso
 <% end %>
 </span>
 </div>
 </div>
 <% elsif summary[:paid_installments] >= plan.installment_count %>
 <div class="completed-badge">
 <strong>Parcelamento concluído</strong>
 </div>
 <% end %>
 
 <!-- Account & Category Info -->
 <div class="plan-metadata">
 <% first_transaction = plan.transactions.first %>
 <% if first_transaction %>
 <% if first_transaction %>
 <% credit_entry = first_transaction.entries.find { |e| e.entry_type == 'credit' } %>
 <div><strong>Conta:</strong> <%= credit_entry&.account&.name || 'N/A' %></div>
 <% end %>
 <div><strong>Categoria:</strong> <%= first_transaction.category&.name || 'N/A' %></div>
 <% else %>
 <div><strong>Conta:</strong> N/A</div>
 <div><strong>Categoria:</strong> N/A</div>
 <% end %>
 <div><strong>Frequência:</strong> <%= plan.recurrence_frequency.capitalize %></div>
 </div>
 
 <!-- Actions -->
 <div class="plan-actions">
 <%= link_to 'Ver', installment_plan_path(plan) %>
 <%= link_to 'Editar', edit_installment_plan_path(plan) %>
 <%= link_to plan.active? ? 'Desativar' : 'Ativar', 
 toggle_active_installment_plan_path(plan), 
 method: :patch %>
 </div>
 </div>
 <% end %>
 </div>
<% else %>
 <div class="empty-state">
 <div class="empty-icon">📊</div>
 <h3>Nenhum plano de parcelamento</h3>
 <p>
 Crie planos de parcelamento para organizar suas compras em várias parcelas.
 </p>
 <%= link_to 'Criar Primeiro Plano', new_installment_plan_path %>
  </div>
<% end %>
</section>
