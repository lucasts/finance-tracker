<div>
 <ul>
 <li><%= link_to "Início", root_path %></li>
 <li><%= link_to "Parcelamentos", installment_plans_path %></li>
 <li><%= @installment_plan.name %></li>
 </ul>
</div>

<div>
 <div>
 <h1>
 📊 <%= @installment_plan.name %>
 <div>
 <%= @installment_plan.active? ? 'Ativo' : 'Inativo' %>
 </div>
 </h1>
 <p><%= @installment_plan.notes if @installment_plan.notes.present? %></p>
 </div>
 
 <div>
 <%= link_to 'Editar', edit_installment_plan_path(@installment_plan) %>
 <%= link_to @installment_plan.active? ? 'Desativar' : 'Ativar', 
 toggle_active_installment_plan_path(@installment_plan), 
 method: :patch %>
 <%= link_to 'Gerar Parcelas', generate_missing_installments_installment_plan_path(@installment_plan), 
 method: :post %>
 <%= link_to 'Voltar', installment_plans_path %>
 </div>
</div>

<!-- Summary Cards -->
<div>
 <div>
 <div>
 <div>
 <div>
 <h3>Valor Total</h3>
 <p>R$ <%= number_with_precision(@installment_plan.total_amount, precision: 2, delimiter: ".") %></p>
 </div>
 <div>💰</div>
 </div>
 <div>
 <%= @installment_plan.installment_count %> parcelas de R$ <%= number_with_precision(@installment_plan.installment_amount, precision: 2, delimiter: ".") %>
 </div>
 </div>
 </div>

 <div>
 <div>
 <div>
 <div>
 <h3>Valor Pago</h3>
 <p>R$ <%= number_with_precision(@progress[:total_paid], precision: 2, delimiter: ".") %></p>
 </div>
 <div>✅</div>
 </div>
 <div>
 <%= @progress[:paid_installments] %> de <%= @installment_plan.installment_count %> parcelas
 </div>
 </div>
 </div>

 <div>
 <div>
 <div>
 <div>
 <h3>Valor Restante</h3>
 <p>R$ <%= number_with_precision(@progress[:remaining_amount], precision: 2, delimiter: ".") %></p>
 </div>
 <div>⏳</div>
 </div>
 <div>
 <%= @progress[:remaining_installments] %> parcelas restantes
 </div>
 </div>
 </div>

 <div>
 <div>
 <div>
 <div>
 <h3>Progresso</h3>
 <p><%= @progress[:progress_percentage] %>%</p>
 </div>
 <div>📈</div>
 </div>
 <div>
 <% if @progress[:next_due_date] %>
 Próxima: <%= l(@progress[:next_due_date], format: :short) %>
 <% else %>
 Concluído!
 <% end %>
 </div>
 </div>
 </div>
</div>

<!-- Progress Bar -->
<div>
 <div>
 <h2>📊 Progresso do Parcelamento</h2>
 
 <div>
 <span>Parcelas Pagas</span>
 <span><%= @progress[:paid_installments] %>/<%= @installment_plan.installment_count %> (<%= @progress[:progress_percentage] %>%)</span>
 </div>
 
 <progress 
 value="<%= @progress[:progress_percentage] %>" max="100"></progress>
 
 <div>
 <div>
 <div>Pagas</div>
 <div><%= @progress[:paid_installments] %> parcelas</div>
 <div>R$ <%= number_with_precision(@progress[:total_paid], precision: 2, delimiter: ".") %></div>
 </div>
 <div>
 <div>Pendentes</div>
 <div><%= @progress[:remaining_installments] %> parcelas</div>
 <div>R$ <%= number_with_precision(@progress[:remaining_amount], precision: 2, delimiter: ".") %></div>
 </div>
 <div>
 <div>Frequência</div>
 <div><%= @installment_plan.recurrence_frequency.capitalize %></div>
 <div>
 <% first_transaction = @installment_plan.transactions.first %>
 <% if first_transaction %>
 <% credit_entry = first_transaction.entries.find { |e| e.entry_type == 'credit' } %>
 <%= credit_entry&.account&.name || 'N/A' %> • <%= @installment_plan.category.name %>
 <% else %>
 <%= @installment_plan.category.name %>
 <% end %>
 </div>
 </div>
 </div>
 </div>
</div>

<!-- Next Installments -->
<% if @next_installments.any? %>
<div>
 <div>
 <h2>📅 Próximas Parcelas</h2>
 
 <div>
 <% @next_installments.each do |installment| %>
 <div>
 <div>
 <div>
 Parcela <%= installment[:number] %>
 </div>
 <div>
 <div>
 <%= l(installment[:date], format: :short) %>
 <% if installment[:overdue] %>
 <span>(Em atraso)</span>
 <% elsif installment[:due_soon] %>
 <span>(Vence em breve)</span>
 <% end %>
 </div>
 <div>
 <% days_diff = (installment[:date] - Date.current).to_i %>
 <% if days_diff == 0 %>
 Vence hoje
 <% elsif days_diff == 1 %>
 Vence amanhã
 <% elsif days_diff > 0 %>
 Vence em <%= days_diff %> dias
 <% else %>
 <%= days_diff.abs %> dias em atraso
 <% end %>
 </div>
 </div>
 </div>
 <div>
 <div>R$ <%= number_with_precision(@installment_plan.installment_amount, precision: 2, delimiter: ".") %></div>
 </div>
 </div>
 <% end %>
 </div>
 </div>
</div>
<% end %>

<!-- Transactions History -->
<div>
 <div>
 <div>
 <h2>📋 Histórico de Parcelas</h2>
 <button 
 data-controller="modal"
 data-modal-id-value="payment_schedule_modal"
 data-action="click->modal#open">
 Ver Cronograma Completo
 </button>
 </div>
 
 <% if @transactions.any? %>
 <div>
 <table>
 <thead>
 <tr>
 <th>Parcela</th>
 <th>Data de Pagamento</th>
 <th>Valor</th>
 <th>Status</th>
 <th>Ações</th>
 </tr>
 </thead>
 <tbody>
 <% @transactions.each do |transaction| %>
 <tr>
 <td>
 <div>
 <%= transaction.installment_number %>/<%= @installment_plan.installment_count %>
 </div>
 </td>
 <td><%= l(transaction.payment_date || transaction.event_date, format: :short) %></td>
 <td>R$ <%= number_with_precision(transaction.amount, precision: 2, delimiter: ".") %></td>
 <td>
 <% if transaction.status == "confirmed" %>
 <div>Pago</div>
 <% elsif transaction.status == "pending" %>
 <div>Pendente</div>
 <% else %>
 <div>Cancelado</div>
 <% end %>
 </td>
 <td>
 <%= link_to 'Ver', transaction_path(transaction) %>
 <%= link_to 'Editar', edit_transaction_path(transaction) %>
 </td>
 </tr>
 <% end %>
 </tbody>
 </table>
 </div>
 <% else %>
 <div>
 <div>📋</div>
 <h3>Nenhuma parcela paga ainda</h3>
 <p>
 As parcelas serão criadas automaticamente conforme as datas de vencimento.
 </p>
 </div>
 <% end %>
 </div>
</div>

<!-- Payment Schedule Modal -->
<dialog id="payment_schedule_modal" >
 <div>
 <form method="dialog">
 <button>✕</button>
 </form>
 
 <h3>📅 Cronograma Completo de Pagamentos</h3>
 
 <div id="payment_schedule_content" >
 <div>
 <span></span>
 </div>
 </div>
 </div>
 <form method="dialog" >
 <button>close</button>
 </form>
</dialog>

<script>
document.addEventListener('DOMContentLoaded', function() {
 const modal = document.getElementById('payment_schedule_modal');
 const content = document.getElementById('payment_schedule_content');
 
 modal.addEventListener('show', function() {
 // Load payment schedule via AJAX
 fetch('<%= payment_schedule_installment_plan_path(@installment_plan) %>')
 .then(response => response.json())
 .then(data => {
 let html = '<div><table>';
 html += '<thead><tr><th>Parcela</th><th>Data de Vencimento</th><th>Valor</th><th>Status</th><th>Data de Pagamento</th></tr></thead>';
 html += '<tbody>';
 
 data.schedule.forEach(installment => {
 let statusBadge = '';
 let statusClass = '';
 
 if (installment.status === 'paid') {
 statusBadge = '<div>Pago</div>';
 } else if (installment.status === 'overdue') {
 statusBadge = '<div>Em atraso</div>';
 statusClass = 'bg-error/10';
 } else {
 statusBadge = '<div>Pendente</div>';
 }
 
 html += `<tr class="${statusClass}">`;
 html += `<td><div>${installment.installment_number}/${data.plan.installment_count}</div></td>`;
 html += `<td>${new Date(installment.due_date).toLocaleDateString('pt-BR')}</td>`;
 html += `<td>${CurrencyHelper.format(installment.amount)}</td>`;
 html += `<td>${statusBadge}</td>`;
 html += `<td>${installment.paid_date ? new Date(installment.paid_date).toLocaleDateString('pt-BR') : '-'}</td>`;
 html += '</tr>';
 });
 
 html += '</tbody></table></div>';
 content.innerHTML = html;
 })
 .catch(error => {
 content.innerHTML = '<div>Erro ao carregar cronograma de pagamentos.</div>';
 });
 });
});
</script>
