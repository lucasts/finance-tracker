<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><%= link_to "Início", root_path %></li>
    <li><%= link_to "Parcelamentos", installment_plans_path %></li>
    <li><%= @installment_plan.name %></li>
  </ul>
</div>

<div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-6 gap-4">
  <div>
    <h1 class="text-3xl font-bold flex items-center gap-3">
      📊 <%= @installment_plan.name %>
      <div class="badge <%= @installment_plan.active? ? 'badge-success' : 'badge-error' %>">
        <%= @installment_plan.active? ? 'Ativo' : 'Inativo' %>
      </div>
    </h1>
    <p class="text-base-content/70 mt-2"><%= @installment_plan.notes if @installment_plan.notes.present? %></p>
  </div>
  
  <div class="flex flex-wrap gap-2">
    <%= link_to 'Editar', edit_installment_plan_path(@installment_plan), class: "btn btn-primary" %>
    <%= link_to @installment_plan.active? ? 'Desativar' : 'Ativar', 
                toggle_active_installment_plan_path(@installment_plan), 
                method: :patch,
                class: "btn #{@installment_plan.active? ? 'btn-warning' : 'btn-success'}" %>
    <%= link_to 'Gerar Parcelas', generate_missing_installments_installment_plan_path(@installment_plan), 
                method: :post, class: "btn btn-outline" %>
    <%= link_to 'Voltar', installment_plans_path, class: "btn btn-ghost" %>
  </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="card bg-primary text-primary-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Valor Total</h3>
          <p class="text-2xl font-bold">R$ <%= number_with_precision(@installment_plan.total_amount, precision: 2, delimiter: ".") %></p>
        </div>
        <div class="text-4xl opacity-80">💰</div>
      </div>
      <div class="text-sm opacity-90">
        <%= @installment_plan.installment_count %> parcelas de R$ <%= number_with_precision(@installment_plan.installment_amount, precision: 2, delimiter: ".") %>
      </div>
    </div>
  </div>

  <div class="card bg-success text-success-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Valor Pago</h3>
          <p class="text-2xl font-bold">R$ <%= number_with_precision(@progress[:total_paid], precision: 2, delimiter: ".") %></p>
        </div>
        <div class="text-4xl opacity-80">✅</div>
      </div>
      <div class="text-sm opacity-90">
        <%= @progress[:paid_installments] %> de <%= @installment_plan.installment_count %> parcelas
      </div>
    </div>
  </div>

  <div class="card bg-warning text-warning-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Valor Restante</h3>
          <p class="text-2xl font-bold">R$ <%= number_with_precision(@progress[:remaining_amount], precision: 2, delimiter: ".") %></p>
        </div>
        <div class="text-4xl opacity-80">⏳</div>
      </div>
      <div class="text-sm opacity-90">
        <%= @progress[:remaining_installments] %> parcelas restantes
      </div>
    </div>
  </div>

  <div class="card bg-info text-info-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Progresso</h3>
          <p class="text-2xl font-bold"><%= @progress[:progress_percentage] %>%</p>
        </div>
        <div class="text-4xl opacity-80">📈</div>
      </div>
      <div class="text-sm opacity-90">
        <% if @progress[:next_due_date] %>
          Próxima: <%= l(@progress[:next_due_date], format: :short) %>
        <% else %>
          Concluído!
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Progress Bar -->
<div class="card bg-base-100 shadow mb-8">
  <div class="card-body">
    <h2 class="card-title mb-4">📊 Progresso do Parcelamento</h2>
    
    <div class="flex justify-between text-sm mb-2">
      <span>Parcelas Pagas</span>
      <span><%= @progress[:paid_installments] %>/<%= @installment_plan.installment_count %> (<%= @progress[:progress_percentage] %>%)</span>
    </div>
    
    <progress class="progress progress-primary w-full h-4 mb-4" 
              value="<%= @progress[:progress_percentage] %>" max="100"></progress>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
      <div class="text-center">
        <div class="font-semibold text-success">Pagas</div>
        <div><%= @progress[:paid_installments] %> parcelas</div>
        <div class="text-success">R$ <%= number_with_precision(@progress[:total_paid], precision: 2, delimiter: ".") %></div>
      </div>
      <div class="text-center">
        <div class="font-semibold text-warning">Pendentes</div>
        <div><%= @progress[:remaining_installments] %> parcelas</div>
        <div class="text-warning">R$ <%= number_with_precision(@progress[:remaining_amount], precision: 2, delimiter: ".") %></div>
      </div>
      <div class="text-center">
        <div class="font-semibold">Frequência</div>
        <div><%= @installment_plan.recurrence_frequency.capitalize %></div>
        <div class="text-base-content/70">
          <%= @installment_plan.account.name %> • <%= @installment_plan.category.name %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Next Installments -->
<% if @next_installments.any? %>
<div class="card bg-base-100 shadow mb-8">
  <div class="card-body">
    <h2 class="card-title mb-4">📅 Próximas Parcelas</h2>
    
    <div class="space-y-3">
      <% @next_installments.each do |installment| %>
        <div class="flex items-center justify-between p-4 border border-base-200 rounded-lg
                    <%= 'bg-error/10 border-error' if installment[:overdue] %>
                    <%= 'bg-warning/10 border-warning' if installment[:due_soon] %>">
          <div class="flex items-center gap-4">
            <div class="badge badge-outline">
              Parcela <%= installment[:number] %>
            </div>
            <div>
              <div class="font-semibold">
                <%= l(installment[:date], format: :short) %>
                <% if installment[:overdue] %>
                  <span class="text-error text-sm">(Em atraso)</span>
                <% elsif installment[:due_soon] %>
                  <span class="text-warning text-sm">(Vence em breve)</span>
                <% end %>
              </div>
              <div class="text-sm text-base-content/70">
                <% days_diff = (installment[:date] - Date.current).to_i %>
                <% if days_diff == 0 %>
                  Vence hoje
                <% elsif days_diff == 1 %>
                  Vence amanhã
                <% elsif days_diff > 0 %>
                  Vence em <%= days_diff %> dias
                <% else %>
                  <%= days_diff.abs %> dias em atraso
                <% end %>
              </div>
            </div>
          </div>
          <div class="text-right">
            <div class="font-semibold">R$ <%= number_with_precision(@installment_plan.installment_amount, precision: 2, delimiter: ".") %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>

<!-- Transactions History -->
<div class="card bg-base-100 shadow">
  <div class="card-body">
    <div class="flex justify-between items-center mb-4">
      <h2 class="card-title">📋 Histórico de Parcelas</h2>
      <button class="btn btn-sm btn-outline" onclick="payment_schedule_modal.showModal()">
        Ver Cronograma Completo
      </button>
    </div>
    
    <% if @transactions.any? %>
      <div class="overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Parcela</th>
              <th>Data de Pagamento</th>
              <th>Valor</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @transactions.each do |transaction| %>
              <tr>
                <td>
                  <div class="badge badge-outline">
                    <%= transaction.installment_number %>/<%= @installment_plan.installment_count %>
                  </div>
                </td>
                <td><%= l(transaction.date, format: :short) %></td>
                <td class="font-semibold">R$ <%= number_with_precision(transaction.amount, precision: 2, delimiter: ".") %></td>
                <td>
                  <div class="badge badge-success">Pago</div>
                </td>
                <td>
                  <%= link_to 'Ver', transaction_path(transaction), class: "btn btn-xs btn-ghost" %>
                  <%= link_to 'Editar', edit_transaction_path(transaction), class: "btn btn-xs btn-outline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-8">
        <div class="text-4xl mb-2">📋</div>
        <h3 class="text-lg font-semibold mb-2">Nenhuma parcela paga ainda</h3>
        <p class="text-base-content/60">
          As parcelas serão criadas automaticamente conforme as datas de vencimento.
        </p>
      </div>
    <% end %>
  </div>
</div>

<!-- Payment Schedule Modal -->
<dialog id="payment_schedule_modal" class="modal">
  <div class="modal-box w-11/12 max-w-4xl">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    
    <h3 class="font-bold text-lg mb-4">📅 Cronograma Completo de Pagamentos</h3>
    
    <div id="payment_schedule_content" class="space-y-4">
      <div class="flex justify-center py-8">
        <span class="loading loading-spinner loading-lg"></span>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const modal = document.getElementById('payment_schedule_modal');
  const content = document.getElementById('payment_schedule_content');
  
  modal.addEventListener('show', function() {
    // Load payment schedule via AJAX
    fetch('<%= payment_schedule_installment_plan_path(@installment_plan) %>')
      .then(response => response.json())
      .then(data => {
        let html = '<div class="overflow-x-auto"><table class="table table-zebra w-full">';
        html += '<thead><tr><th>Parcela</th><th>Data de Vencimento</th><th>Valor</th><th>Status</th><th>Data de Pagamento</th></tr></thead>';
        html += '<tbody>';
        
        data.schedule.forEach(installment => {
          let statusBadge = '';
          let statusClass = '';
          
          if (installment.status === 'paid') {
            statusBadge = '<div class="badge badge-success">Pago</div>';
          } else if (installment.status === 'overdue') {
            statusBadge = '<div class="badge badge-error">Em atraso</div>';
            statusClass = 'bg-error/10';
          } else {
            statusBadge = '<div class="badge badge-outline">Pendente</div>';
          }
          
          html += `<tr class="${statusClass}">`;
          html += `<td><div class="badge badge-outline">${installment.installment_number}/${data.plan.installment_count}</div></td>`;
          html += `<td>${new Date(installment.due_date).toLocaleDateString('pt-BR')}</td>`;
          html += `<td class="font-semibold">R$ ${installment.amount.toFixed(2).replace('.', ',')}</td>`;
          html += `<td>${statusBadge}</td>`;
          html += `<td>${installment.paid_date ? new Date(installment.paid_date).toLocaleDateString('pt-BR') : '-'}</td>`;
          html += '</tr>';
        });
        
        html += '</tbody></table></div>';
        content.innerHTML = html;
      })
      .catch(error => {
        content.innerHTML = '<div class="alert alert-error">Erro ao carregar cronograma de pagamentos.</div>';
      });
  });
});
</script>
