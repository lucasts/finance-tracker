<div class="min-h-screen bg-base-200 flex items-center justify-center p-4">
  <div class="card w-full max-w-md bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title justify-center text-2xl mb-6">
        <%= t('devise.unlocks.new.resend_unlock_instructions') %>
      </h2>

      <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-control">
          <%= f.label :email, class: "label" %>
          <span class="label-text"><%= t('activerecord.attributes.user.email') %></span>
          <%= f.email_field :email, 
                            autofocus: true, 
                            autocomplete: "email",
                            class: "input input-bordered w-full",
                            placeholder: t('activerecord.attributes.user.email') %>
        </div>

        <div class="form-control mt-6">
          <%= f.submit t('devise.unlocks.new.resend_unlock_instructions'), 
                      class: "btn btn-primary w-full" %>
        </div>
      <% end %>

      <div class="divider"></div>
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
