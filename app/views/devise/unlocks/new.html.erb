<% content_for :title, "Desbloquear conta" %>

<div>
 <div>
 <div>
 <!-- Header -->
 <div>
 <%= image_tag "full_logo_orzeny-min.png", alt: "Orzeny - Clareza para suas finanças", class: "h-20 w-auto mx-auto mb-4" %>
 <p>Desbloquear conta</p>
 <p>
 Digite seu email para receber instruções de desbloqueio.
 </p>
 </div>

 <!-- Error Messages -->
 <%= render "devise/shared/error_messages", resource: resource %>

 <!-- Unlock Form -->
 <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), html: { method: :post }, local: true, class: "space-y-4") do |f| %>
 
 <!-- Email Field -->
 <div>
 <%= f.label :email, class: "label" do %>
 <span>Email</span>
 <% end %>
 <%= f.email_field :email, 
 autofocus: true, 
 autocomplete: "email",
 class: "input input-bordered w-full",
 placeholder: "seu@email.com" %>
 </div>

 <!-- Submit Button -->
 <div>
 <%= f.submit "Reenviar instruções de desbloqueio", 
  %>
 </div>
 <% end %>

 <!-- Divider -->
 <div>ou</div>
 <div>
 <%= render "devise/shared/links" %>
 </div>
 </div>
 </div>
</div>
