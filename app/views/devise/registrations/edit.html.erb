<% content_for :title, "Editar Perfil" %>

<div>
 <!-- Breadcrumb -->
 <div>
 <ul>
 <li><%= link_to "Visão Geral", root_path %></li>
 <li>Editar Perfil</li>
 </ul>
 </div>

 <!-- Header -->
 <div>
 <h1>
 Editar Perfil
 </h1>
 <p>
 Atualize suas informações pessoais e preferências de conta.
 </p>
 </div>

 <div>
 <!-- Main Form -->
 <div>
 <div>
 <div>
 <h2>Informações da Conta</h2>
 
 <!-- Error Messages -->
 <%= render "devise/shared/error_messages", resource: resource %>

 <!-- Edit Form -->
 <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }, local: true, class: "space-y-4") do |f| %>
 
 <!-- Email Field -->
 <div>
 <%= f.label :email, class: "label" do %>
 <span>Email</span>
 <% end %>
 <%= f.email_field :email, 
 autofocus: true, 
 autocomplete: "email",
 class: "input input-bordered w-full" %>
 <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
 <label>
 <span>
 Aguardando confirmação para: <%= resource.unconfirmed_email %>
 </span>
 </label>
 <% end %>
 </div>

 <!-- Password Field -->
 <div>
 <%= f.label :password, class: "label" do %>
 <span>Nova Senha</span>
 <span>(deixe em branco se não quiser alterar)</span>
 <% end %>
 <%= f.password_field :password, 
 autocomplete: "new-password",
 class: "input input-bordered w-full",
 placeholder: "••••••••" %>
 <% if @minimum_password_length %>
 <label>
 <span>Mínimo <%= @minimum_password_length %> caracteres</span>
 </label>
 <% end %>
 </div>

 <!-- Password Confirmation Field -->
 <div>
 <%= f.label :password_confirmation, class: "label" do %>
 <span>Confirme a Nova Senha</span>
 <% end %>
 <%= f.password_field :password_confirmation, 
 autocomplete: "new-password",
 class: "input input-bordered w-full",
 placeholder: "••••••••" %>
 </div>

 <!-- Current Password Field -->
 <div>
 <%= f.label :current_password, class: "label" do %>
 <span>Senha Atual</span>
 <span>(necessária para confirmar as alterações)</span>
 <% end %>
 <%= f.password_field :current_password, 
 autocomplete: "current-password",
 class: "input input-bordered w-full",
 placeholder: "••••••••" %>
 </div>

 <!-- Submit Button -->
 <div>
 <%= f.submit "Atualizar", 
  %>
 </div>
 <% end %>
 </div>
 </div>
 </div>

 <!-- Sidebar -->
 <div>
 <!-- Account Actions -->
 <div>
 <div>
 <h3>Ações da Conta</h3>
 
 <div>
 <%= link_to root_path do %>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
 </svg>
 Voltar ao Dashboard
 <% end %>
 </div>
 </div>
 </div>

 <!-- Danger Zone -->
 <div>
 <div>
 <h3>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
 </svg>
 Zona de Perigo
 </h3>
 
 <p>
 Esta ação não pode ser desfeita. Todos os seus dados serão permanentemente removidos.
 </p>
 
 <%= button_to "Excluir minha conta", 
 registration_path(resource_name), 
 data: { 
 confirm: "Tem certeza? Esta ação não pode ser desfeita!", 
 turbo_confirm: "Tem certeza? Esta ação não pode ser desfeita!" 
 }, 
 method: :delete,
  %>
 </div>
 </div>
 </div>
 </div>
</div>
