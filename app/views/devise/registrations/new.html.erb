<% content_for :title, "Criar Conta" %>

<div class="min-h-screen flex items-center justify-center bg-base-200">
  <div class="card w-full max-w-md bg-base-100 shadow-xl">
    <div class="card-body">
      <!-- Header -->
      <div class="text-center mb-6">
        <h1 class="text-3xl font-bold text-primary">Finance Tracker</h1>
        <p class="text-base-content/70 mt-2">Crie sua conta</p>
      </div>

      <!-- Error Messages -->
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Registration Form -->
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, class: "space-y-4") do |f| %>
        
        <!-- Email Field -->
        <div class="form-control">
          <%= f.label :email, class: "label" do %>
            <span class="label-text font-medium">Email</span>
          <% end %>
          <%= f.email_field :email, 
                            autofocus: true, 
                            autocomplete: "email",
                            class: "input input-bordered w-full",
                            placeholder: "seu@email.com" %>
        </div>

        <!-- Password Field -->
        <div class="form-control">
          <%= f.label :password, class: "label" do %>
            <span class="label-text font-medium">Senha</span>
            <% if @minimum_password_length %>
              <span class="label-text-alt">(mínimo <%= @minimum_password_length %> caracteres)</span>
            <% end %>
          <% end %>
          <%= f.password_field :password, 
                              autocomplete: "new-password",
                              class: "input input-bordered w-full",
                              placeholder: "••••••••" %>
        </div>

        <!-- Password Confirmation Field -->
        <div class="form-control">
          <%= f.label :password_confirmation, class: "label" do %>
            <span class="label-text font-medium">Confirme a Senha</span>
          <% end %>
          <%= f.password_field :password_confirmation, 
                              autocomplete: "new-password",
                              class: "input input-bordered w-full",
                              placeholder: "••••••••" %>
        </div>

        <!-- Submit Button -->
        <div class="form-control mt-6">
          <%= f.submit "Criar Conta", 
                      class: "btn btn-primary btn-block text-white" %>
        </div>
      <% end %>

      <!-- Divider -->
      <div class="divider">ou</div>

      <!-- Links -->
      <div class="text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
