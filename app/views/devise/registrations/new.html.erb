<% content_for :title, "Criar Conta" %>

<div>
 <div>
 <div>
 <!-- Header -->
 <div>
 <%= image_tag "full_logo_orzeny-min.png", alt: "Orzeny - Clareza para suas finanças", class: "h-20 w-auto mx-auto mb-4" %>
 <p>Crie sua conta</p>
 </div>

 <!-- Error Messages -->
 <%= render "devise/shared/error_messages", resource: resource %>

 <!-- Registration Form -->
 <%= form_for(resource, as: resource_name, url: registration_path(resource_name), local: true, class: "space-y-4") do |f| %>
 
 <!-- Email Field -->
 <div>
 <%= f.label :email, class: "label" do %>
 <span>Email</span>
 <% end %>
 <%= f.email_field :email, 
 autofocus: true, 
 autocomplete: "email",
 class: "input input-bordered w-full",
 placeholder: "seu@email.com" %>
 </div>

 <!-- Password Field -->
 <div>
 <%= f.label :password, class: "label" do %>
 <span>Senha</span>
 <% if @minimum_password_length %>
 <span>(mínimo <%= @minimum_password_length %> caracteres)</span>
 <% end %>
 <% end %>
 <%= f.password_field :password, 
 autocomplete: "new-password",
 class: "input input-bordered w-full",
 placeholder: "••••••••" %>
 </div>

 <!-- Password Confirmation Field -->
 <div>
 <%= f.label :password_confirmation, class: "label" do %>
 <span>Confirme a Senha</span>
 <% end %>
 <%= f.password_field :password_confirmation, 
 autocomplete: "new-password",
 class: "input input-bordered w-full",
 placeholder: "••••••••" %>
 </div>

 <!-- Submit Button -->
 <div>
 <%= f.submit "Criar Conta"
  %>
 </div>
 <% end %>

 <!-- Divider -->
 <div>ou</div>

 <!-- Links -->
 <div>
 <%= render "devise/shared/links" %>
 </div>
 </div>
 </div>
</div>
