<% content_for :title, "Entrar" %>

<div>
 <div>
 <div>
 <!-- Header -->
 <div>
 <%= image_tag "full_logo_orzeny-min.png", alt: "Orzeny - Clareza para suas finanças", class: "h-20 w-auto mx-auto mb-4" %>
 <p><%= t('app.taglines.login') %></p>
 </div>

 <!-- Flash Messages -->
 <% if notice %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <span><%= notice %></span>
 </div>
 <% end %>
 
 <% if alert %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <span><%= alert %></span>
 </div>
 <% end %>

 <!-- Login Form -->
 <%= form_for(resource, as: resource_name, url: session_path(resource_name), local: true, class: "space-y-4") do |f| %>
 
 <!-- Email Field -->
 <div>
 <%= f.label :email, class: "label" do %>
 <span>Email</span>
 <% end %>
 <%= f.email_field :email, 
 autofocus: true, 
 autocomplete: "email",
 class: "input input-bordered w-full",
 placeholder: "seu@email.com" %>
 </div>

 <!-- Password Field -->
 <div>
 <%= f.label :password, class: "label" do %>
 <span>Senha</span>
 <% end %>
 <%= f.password_field :password, 
 autocomplete: "current-password",
 class: "input input-bordered w-full",
 placeholder: "••••••••" %>
 </div>

 <!-- Remember Me -->
 <% if devise_mapping.rememberable? %>
 <div>
 <label>
 <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
 <span>Lembrar-me</span>
 </label>
 </div>
 <% end %>

 <!-- Submit Button -->
 <div>
 <%= f.submit "Entrar", 
  %>
 </div>
 <% end %>

 <!-- Divider -->
 <div>ou</div>

 <!-- Links -->
 <div>
 <%= render "devise/shared/links" %>
 </div>

 <!-- Demo User Info - Only in Development -->
 <% if Rails.env.development? %>
 <div>
 <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
 </svg>
 <div>
 <h3>Usuário Demo</h3>
 <div>
 Email: <strong>admin@example.com</strong><br>
 Senha: <strong>password</strong>
 </div>
 </div>
 </div>
 <% end %>
 </div>
 </div>
</div>
