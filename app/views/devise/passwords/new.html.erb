<% content_for :title, "Recuperar Senha" %>

<div>
 <div>
 <div>
 <!-- Header -->
 <div>
 <%= image_tag "full_logo_orzeny-min.png", alt: "Orzeny - Clareza para suas finanças", class: "h-20 w-auto mx-auto mb-4" %>
 <p>Esqueceu sua senha?</p>
 <p>
 Digite seu email abaixo e enviaremos instruções para redefinir sua senha.
 </p>
 </div>

 <!-- Error Messages -->
 <%= render "devise/shared/error_messages", resource: resource %>

 <!-- Password Reset Form -->
 <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, local: true, class: "space-y-4") do |f| %>
 
 <!-- Email Field -->
 <div>
 <%= f.label :email, class: "label" do %>
 <span>Email</span>
 <% end %>
 <%= f.email_field :email, 
 autofocus: true, 
 autocomplete: "email",
 class: "input input-bordered w-full",
 placeholder: "seu@email.com" %>
 </div>

 <!-- Submit Button -->
 <div>
 <%= f.submit "Enviar instruções", 
  %>
 </div>
 <% end %>

 <!-- Divider -->
 <div>ou</div>

 <!-- Links -->
 <div>
 <%= render "devise/shared/links" %>
 </div>
 </div>
 </div>
</div>
