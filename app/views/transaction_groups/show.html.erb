<div class="mb-4">
  <%= link_to transaction_groups_path, class: "btn btn-ghost btn-sm" do %>
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Voltar
  <% end %>
</div>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-3xl font-bold flex items-center gap-2">
      <%= case @group.group_type
          when 'installment' then '💳'
          when 'loan' then '🏦'
          when 'transfer' then '↔️'
          else '📊'
          end %>
      <%= @group.name %>
    </h1>
    <div class="flex items-center gap-3 mt-2">
      <div class="badge <%= case @group.group_type
                            when 'installment' then 'badge-primary'
                            when 'loan' then 'badge-secondary'
                            when 'transfer' then 'badge-accent'
                            else 'badge-neutral'
                            end %>">
        <%= case @group.group_type
            when 'installment' then 'Parcelamento de cartão de crédito'
            when 'loan' then 'Empréstimo'
            when 'transfer' then 'Transferência agrupada'
            else @group.group_type.titleize
            end %>
      </div>
      <% if @group.installment_count.present? %>
        <span class="text-base-content/60">• <%= pluralize(@group.installment_count, 'parcela') %></span>
      <% end %>
      <% if @group.starts_on || @group.created_at %>
        <span class="text-base-content/60">
          • Iniciado em <%= l(@group.starts_on || @group.created_at.to_date, format: :short) %>
        </span>
      <% end %>
    </div>
  </div>
  <%= link_to edit_transaction_group_path(@group), class: "btn btn-outline btn-sm" do %>
    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
    </svg>
    Editar
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="stats shadow">
    <div class="stat">
      <div class="stat-figure text-success">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="stat-title">Valor Pago</div>
      <div class="stat-value text-success">R$ <%= number_with_precision(@total_paid, precision: 2, separator: ",", delimiter: ".") %></div>
      <div class="stat-desc"><%= @paid.count %> de <%= @transactions.count %> parcelas concluídas</div>
    </div>
  </div>
  
  <div class="stats shadow">
    <div class="stat">
      <div class="stat-figure text-error">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="stat-title">Restante a Pagar</div>
      <div class="stat-value text-error">R$ <%= number_with_precision(@total_due, precision: 2, separator: ",", delimiter: ".") %></div>
      <div class="stat-desc"><%= @unpaid.count %> parcelas pendentes</div>
    </div>
  </div>
  
  <div class="stats shadow">
    <div class="stat">
      <div class="stat-figure text-info">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
      </div>
      <div class="stat-title">Valor Total</div>
      <div class="stat-value text-info">R$ <%= number_with_precision(@total_value, precision: 2, separator: ",", delimiter: ".") %></div>
      <% if @transactions.count > 0 %>
        <div class="stat-desc">
          <div class="flex items-center gap-2 mt-2">
            <progress class="progress progress-<%= @paid.count == @transactions.count ? 'success' : 'info' %> w-20" 
                      value="<%= @paid.count %>" max="<%= @transactions.count %>"></progress>
            <span class="text-sm font-medium">
              <%= number_to_percentage((@paid.count.to_f / @transactions.count * 100), precision: 1) %> concluído
            </span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if @transactions.any? %>
<div class="bg-base-100 rounded-box shadow overflow-hidden">
  <div class="p-4 bg-base-200 border-b">
    <h2 class="text-xl font-semibold flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
      </svg>
      Detalhamento das Parcelas
    </h2>
    <p class="text-sm text-base-content/60 mt-1">
      Acompanhe o pagamento de cada parcela do grupo
    </p>
  </div>
  <div class="overflow-x-auto">
    <table class="table table-zebra w-full">
      <thead class="bg-base-300">
        <tr>
          <th>Parcela</th>
          <th>Data do Pagamento</th>
          <th class="text-right">Valor</th>
          <th class="text-center">Status</th>
        </tr>
      </thead>
      <tbody>
        <% @transactions.each_with_index do |tx, index| %>
          <tr class="<%= tx.status == 'confirmed' ? 'bg-success/10' : 'hover' %>">
            <td>
              <div class="flex items-center gap-3">
                <div class="avatar placeholder">
                  <div class="bg-<%= tx.status == 'confirmed' ? 'success' : 'base-300' %> text-<%= tx.status == 'confirmed' ? 'success-content' : 'base-content' %> rounded-full w-8 h-8 flex items-center justify-center">
                    <span class="text-xs font-semibold"><%= tx.installment %></span>
                  </div>
                </div>
                <span class="font-medium"><%= tx.installment %> / <%= @group.installment_count %></span>
              </div>
            </td>
            <td>
              <% if tx.payment_date %>
                <div class="flex flex-col">
                  <span class="font-medium"><%= l(tx.payment_date, format: :short) %></span>
                  <span class="text-xs text-base-content/60"><%= l(tx.payment_date, format: '%A') %></span>
                </div>
              <% else %>
                <span class="text-base-content/40">—</span>
              <% end %>
            </td>
            <td class="text-right">
              <span class="font-semibold text-lg">
                <%= number_to_currency(tx.amount, unit: "R$", separator: ",", delimiter: ".") %>
              </span>
            </td>
            <td class="text-center">
              <% if tx.status == "confirmed" %>
                <div class="badge badge-success gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  Pago
                </div>
              <% else %>
                <div class="badge badge-warning gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Pendente
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% else %>
<div class="bg-base-100 rounded-box shadow p-8 text-center">
  <div class="text-6xl mb-4">📋</div>
  <h3 class="text-xl font-semibold mb-2">Nenhuma transação encontrada</h3>
  <p class="text-base-content/60 mb-4">
    Este grupo ainda não possui transações associadas. Adicione transações para começar a acompanhar os pagamentos.
  </p>
  <%= link_to transactions_path, class: "btn btn-primary" do %>
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
    </svg>
    Adicionar Transações
  <% end %>
</div>
<% end %>

<div class="mt-8 flex justify-between items-center">
  <div class="flex gap-3">
    <%= link_to transaction_groups_path, class: "link link-primary flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0l-4-4m4 4l-4 4"></path>
      </svg>
      Ver todos os grupos
    <% end %>
    <%= link_to transactions_path, class: "link link-secondary flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
      </svg>
      Ver transações individuais
    <% end %>
  </div>
  
  <div class="text-right">
    <% completion_rate = @transactions.count > 0 ? (@paid.count.to_f / @transactions.count * 100).round : 0 %>
    <div class="text-sm text-base-content/60 mb-1">
      <% if completion_rate == 100 %>
        🎉 Parcelamento concluído!
      <% elsif completion_rate > 0 %>
        ⏳ <%= completion_rate %>% concluído
      <% else %>
        📋 Aguardando início dos pagamentos
      <% end %>
    </div>
  </div>
</div>