<h1 class="text-2xl font-bold mb-4">Parcelamento: <%= @group.name %></h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="bg-green-50 border-l-4 border-green-500 p-4 rounded shadow-sm">
    <p class="text-sm text-green-700 font-medium">Parcelas Pagas</p>
    <p class="text-xl font-bold text-green-900">R$ <%= number_with_precision(@total_paid, precision: 2, separator: ",") %></p>
  </div>
  <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded shadow-sm">
    <p class="text-sm text-red-700 font-medium">Restante a Pagar</p>
    <p class="text-xl font-bold text-red-900">R$ <%= number_with_precision(@total_due, precision: 2, separator: ",") %></p>
  </div>
  <div class="bg-gray-50 border-l-4 border-gray-500 p-4 rounded shadow-sm">
    <p class="text-sm text-gray-700 font-medium">Valor Total</p>
    <p class="text-xl font-bold text-gray-900">R$ <%= number_with_precision(@total_value, precision: 2, separator: ",") %></p>
  </div>
</div>

<table class="w-full bg-white shadow rounded text-sm">
  <thead class="bg-gray-100 text-gray-600">
    <tr>
      <th class="p-2 text-left">Parcela</th>
      <th class="p-2 text-left">Data do evento (competência)</th>
      <th class="p-2 text-left">Data de pagamento (caixa)</th>
      <th class="p-2 text-left">Valor</th>
      <th class="p-2 text-left">Status</th>
    </tr>
  </thead>
  <tbody>
    <% @transactions.each do |tx| %>
      <tr class="border-t hover:bg-gray-50">
        <td class="p-2"> <%= tx.installment %> / <%= @group.installment_count %></td>
        <td class="p-2"><%= l(tx.event_date, format: :long) if tx.event_date %></td>
        <td class="p-2"><%= l(tx.payment_date, format: :long) if tx.payment_date %></td>
        <td class="p-2"> <%= number_to_currency(tx.amount, unit: "R$", separator: ",", delimiter: ".") %></td>
        <td class="p-2">
          <% status_color = tx.status == "confirmed" ? "text-green-700" : "text-red-600" %>
          <span class="font-semibold <%= status_color %>"><%= tx.status.capitalize %></span>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-6">
  <%= link_to "← Voltar para os lançamentos", transactions_path, class: "text-sm text-blue-600 hover:underline" %>
</div>