<div class="breadcrumbs text-sm mb-6">
  <ul>
    <li><%= link_to "Início", root_path %></li>
    <li>Automação</li>
  </ul>
</div>

<div class="flex justify-between items-center mb-6">
  <h1 class="text-3xl font-bold">🤖 Automação de Transações</h1>
  <div class="flex gap-2">
    <%= link_to "📊 Relatórios", reports_path, class: "btn btn-outline btn-sm" %>
    <%= link_to "💰 Transações", transactions_path, class: "btn btn-outline btn-sm" %>
  </div>
</div>

<!-- Status Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="card bg-primary text-primary-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Compromissos Ativos</h3>
          <p class="text-2xl font-bold"><%= @automation_stats[:active_recurring_commitments] %></p>
        </div>
        <div class="text-4xl opacity-80">🔄</div>
      </div>
      <div class="text-sm opacity-90">
        Gerando transações automaticamente
      </div>
    </div>
  </div>

  <div class="card bg-secondary text-secondary-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Parcelamentos Ativos</h3>
          <p class="text-2xl font-bold"><%= @automation_stats[:active_installment_plans] %></p>
        </div>
        <div class="text-4xl opacity-80">📊</div>
      </div>
      <div class="text-sm opacity-90">
        Parcelas sendo processadas
      </div>
    </div>
  </div>

  <div class="card bg-success text-success-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Transações (Mês)</h3>
          <p class="text-2xl font-bold"><%= @automation_stats[:transactions_this_month] %></p>
        </div>
        <div class="text-4xl opacity-80">✅</div>
      </div>
      <div class="text-sm opacity-90">
        Total criadas automaticamente
      </div>
    </div>
  </div>

  <div class="card bg-info text-info-content shadow">
    <div class="card-body">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-lg font-semibold">Status Sistema</h3>
          <p class="text-2xl font-bold">🟢</p>
        </div>
        <div class="text-4xl opacity-80">⚡</div>
      </div>
      <div class="text-sm opacity-90">
        Todos os sistemas operacionais
      </div>
    </div>
  </div>
</div>

<!-- Manual Actions -->
<div class="card bg-base-100 shadow mb-8">
  <div class="card-body">
    <h2 class="card-title mb-4">🎮 Ações Manuais</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Daily Automation -->
      <div class="card bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20">
        <div class="card-body">
          <h3 class="card-title text-primary">🚀 Automação Completa</h3>
          <p class="text-sm text-base-content/70 mb-4">
            Executa todas as automações (transações recorrentes + parcelas) para o dia atual.
          </p>
          <%= link_to run_daily_automation_index_path, method: :post, 
                      class: "btn btn-primary w-full",
                      data: { confirm: "Executar automação completa para hoje?" } do %>
            🤖 Executar Tudo
          <% end %>
        </div>
      </div>

      <!-- Recurring Only -->
      <div class="card bg-gradient-to-br from-success/10 to-success/5 border border-success/20">
        <div class="card-body">
          <h3 class="card-title text-success">🔄 Apenas Recorrentes</h3>
          <p class="text-sm text-base-content/70 mb-4">
            Gera apenas transações de compromissos recorrentes que estão pendentes.
          </p>
          <%= link_to run_recurring_automation_index_path, method: :post, 
                      class: "btn btn-success w-full",
                      data: { confirm: "Gerar transações recorrentes?" } do %>
            🔄 Gerar Recorrentes
          <% end %>
        </div>
      </div>

      <!-- Installments Only -->
      <div class="card bg-gradient-to-br from-warning/10 to-warning/5 border border-warning/20">
        <div class="card-body">
          <h3 class="card-title text-warning">📊 Apenas Parcelas</h3>
          <p class="text-sm text-base-content/70 mb-4">
            Gera apenas parcelas de parcelamentos que estão vencidas ou a vencer.
          </p>
          <%= link_to run_installments_automation_index_path, method: :post, 
                      class: "btn btn-warning w-full",
                      data: { confirm: "Gerar parcelas pendentes?" } do %>
            📊 Gerar Parcelas
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Schedule Information -->
<div class="card bg-base-100 shadow mb-8">
  <div class="card-body">
    <h2 class="card-title mb-4">⏰ Cronograma Automático</h2>
    
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Tipo de Job</th>
            <th>Frequência</th>
            <th>Horário</th>
            <th>Última Execução</th>
            <th>Próxima Execução</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <div class="flex items-center gap-2">
                🔄 <span class="font-semibold">Transações Recorrentes</span>
              </div>
            </td>
            <td>Diário</td>
            <td>06:00</td>
            <td>Hoje, 06:00</td>
            <td>Amanhã, 06:00</td>
            <td><div class="badge badge-success">Ativo</div></td>
          </tr>
          <tr>
            <td>
              <div class="flex items-center gap-2">
                📊 <span class="font-semibold">Parcelas</span>
              </div>
            </td>
            <td>Diário</td>
            <td>06:30</td>
            <td>Hoje, 06:30</td>
            <td>Amanhã, 06:30</td>
            <td><div class="badge badge-success">Ativo</div></td>
          </tr>
          <tr>
            <td>
              <div class="flex items-center gap-2">
                🧹 <span class="font-semibold">Manutenção</span>
              </div>
            </td>
            <td>Semanal</td>
            <td>Dom, 02:00</td>
            <td>Dom passado, 02:00</td>
            <td>Próx Dom, 02:00</td>
            <td><div class="badge badge-info">Programado</div></td>
          </tr>
          <tr>
            <td>
              <div class="flex items-center gap-2">
                📈 <span class="font-semibold">Relatórios Mensais</span>
              </div>
            </td>
            <td>Mensal</td>
            <td>1º dia, 08:00</td>
            <td>1º deste mês, 08:00</td>
            <td>1º próx mês, 08:00</td>
            <td><div class="badge badge-info">Programado</div></td>
          </tr>
        </tbody>
      </table>
    </div>
    
    <div class="alert alert-info mt-4">
      <div class="flex">
        <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <h3 class="font-bold">ℹ️ Informações sobre Automação</h3>
          <div class="text-sm mt-2">
            <ul class="list-disc list-inside space-y-1">
              <li>Jobs automáticos são executados apenas em ambiente de produção</li>
              <li>Em desenvolvimento, use as ações manuais acima</li>
              <li>Todas as execuções são logadas para auditoria</li>
              <li>Jobs falhados são automaticamente reprocessados</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Activity -->
<div class="card bg-base-100 shadow">
  <div class="card-body">
    <h2 class="card-title mb-4">📋 Atividade Recente</h2>
    
    <div class="text-center py-8">
      <div class="text-4xl mb-2">🤖</div>
      <h3 class="text-lg font-semibold mb-2">Nenhuma atividade recente</h3>
      <p class="text-base-content/60 mb-4">
        Execute uma das ações manuais acima para ver os resultados aqui.
      </p>
      <button class="btn btn-primary" onclick="location.reload()">
        🔄 Atualizar Status
      </button>
    </div>
  </div>
</div>

<script>
// Auto-refresh status every 30 seconds
setInterval(function() {
  // In a real implementation, you'd fetch job status via AJAX
  console.log('Checking automation status...');
}, 30000);
</script>
