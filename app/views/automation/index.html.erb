</div>

<!-- Manual Actions -->
<div class="card bg-base-100 shadow mb-8">
  <div class="card-body">
    <h2 class="card-title mb-4">🎮 Ações Manuais</h2>
    
    <!-- Data para teste de automação -->
    <div class="mb-4 p-4 bg-info/10 rounded-lg border border-info/20">
      <h3 class="font-medium text-info mb-2">📅 Data para Testes</h3>
      <div class="flex gap-2 items-center">
        <input type="date" id="test_date" class="input input-bordered input-sm" value="<%= Date.current.next_month.change(day: 5).to_s %>" />
        <span class="text-sm text-base-content/70">Selecione uma data futura para teste (ex: 05/07/2025)</span>
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Daily Automation -->
      <div class="card bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20">
        <div class="card-body">
          <h3 class="card-title text-primary">🚀 Automação Completa</h3>
          <p class="text-sm text-base-content/70 mb-4">
            Executa todas as automações (transações recorrentes + parcelas) para a data selecionada.
          </p>
          <button id="run_daily" class="btn btn-primary w-full">
            🤖 Executar Tudo
          </button>
        </div>
      </div>

      <!-- Recurring Only -->
      <div class="card bg-gradient-to-br from-success/10 to-success/5 border border-success/20">
        <div class="card-body">
          <h3 class="card-title text-success">🔄 Apenas Recorrentes</h3>
          <p class="text-sm text-base-content/70 mb-4">
            Gera apenas transações de compromissos recorrentes para a data selecionada.
          </p>
          <button id="run_recurring" class="btn btn-success w-full">
            🔄 Gerar Recorrentes
          </button>
        </div>
      </div>

      <!-- Installments Only -->
      <div class="card bg-gradient-to-br from-warning/10 to-warning/5 border border-warning/20">
        <div class="card-body">
          <h3 class="card-title text-warning">📊 Apenas Parcelas</h3>
          <p class="text-sm text-base-content/70 mb-4">
            Gera apenas parcelas de parcelamentos para a data selecionada.
          </p>
          <button id="run_installments" class="btn btn-warning w-full">
            📊 Gerar Parcelas
          </button>
        </div>
      </div>
    </div>

    <!-- Script para submeter o formulário com a data personalizada -->
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        function submitWithDate(url) {
          const testDate = document.getElementById('test_date').value;
          const form = document.createElement('form');
          form.method = 'post';
          form.action = url;
          
          const dateInput = document.createElement('input');
          dateInput.type = 'hidden';
          dateInput.name = 'test_date';
          dateInput.value = testDate;
          
          const tokenInput = document.createElement('input');
          tokenInput.type = 'hidden';
          tokenInput.name = 'authenticity_token';
          tokenInput.value = document.querySelector('meta[name="csrf-token"]').content;
          
          form.appendChild(dateInput);
          form.appendChild(tokenInput);
          document.body.appendChild(form);
          
          if (confirm(`Executar automação para a data ${testDate}?`)) {
            form.submit();
          }
          
          document.body.removeChild(form);
        }
        
        document.getElementById('run_daily').addEventListener('click', function() {
          submitWithDate('<%= run_daily_automation_index_path %>');
        });
        
        document.getElementById('run_recurring').addEventListener('click', function() {
          submitWithDate('<%= run_recurring_automation_index_path %>');
        });
        
        document.getElementById('run_installments').addEventListener('click', function() {
          submitWithDate('<%= run_installments_automation_index_path %>');
        });
      });
    </script>
  </div>
</div>

