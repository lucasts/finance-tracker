<h1>📊 <%= t('ui.navigation.reports') %></h1>

<!-- Month navigation -->
<div>
 <div>
 <%= link_to '<', reports_path(month: @prev_month) %>
 <span><%= @selected_month_long %></span>
 <%= link_to '>', reports_path(month: @next_month) %>
 </div>
 
 <div>
 <%= link_to "📈 Dashboard", overview_index_path %>
 <%= link_to "💳 Faturas", credit_statements_path %>
 </div>
</div>

<!-- Summary Cards -->
<div>
 <!-- Total Transactions -->
 <div>
 <div>
 <h2>📝 Transações</h2>
 <p><%= @total_transactions %></p>
 <div>
 <span><%= @income_count %> receitas</span> • 
 <span><%= @expense_count %> despesas</span>
 </div>
 </div>
 </div>

 <!-- Income -->
 <div>
 <div>
 <h2>💰 Receitas</h2>
 <p>R$ <%= number_with_precision(@income_total, precision: 2, delimiter: ".") %></p>
 </div>
 </div>

 <!-- Expenses -->
 <div>
 <div>
 <h2>💸 Despesas</h2>
 <p>R$ <%= number_with_precision(@expense_total, precision: 2, delimiter: ".") %></p>
 </div>
 </div>

 <!-- Savings Rate -->
 <div>
 <div>
 <h2>💎 Taxa de Poupança</h2>
 <p><%= @savings_rate %>%</p>
 <div>
 Média 6m: <span><%= @avg_savings_rate %>%</span>
 </div>
 </div>
 </div>
</div>

<!-- Main Content Grid -->
<div>
 
 <!-- Category Analysis -->
 <div>
 <div>
 <h3>🏷️ Análise por Categoria</h3>
 
 <% if @category_percentages.any? %>
 <div>
 <% @category_percentages.each do |category, amount, percentage| %>
 <div>
 <div>
 <div>
 <span><%= category %></span>
 <span><%= percentage %>%</span>
 </div>
 <div>
 <div 
 style="width: <%= percentage %>%"></div>
 </div>
 </div>
 <div>
 <div>R$ <%= number_with_precision(amount, precision: 2, delimiter: ".") %></div>
 </div>
 </div>
 <% end %>
 </div>
 <% else %>
 <div>
 <div>📊</div>
 <p>Nenhuma despesa categorizada no período</p>
 </div>
 <% end %>
 </div>
 </div>

 <!-- Monthly Trends -->
 <div>
 <div>
 <h3>📈 Tendências (6 Meses)</h3>
 
 <div>
 <table>
 <thead>
 <tr>
 <th>Mês</th>
 <th>Receitas</th>
 <th>Despesas</th>
 <th>Saldo</th>
 <th>Taxa Poupança</th>
 </tr>
 </thead>
 <tbody>
 <% @monthly_trends.each do |trend| %>
 <tr>
 <td>
 <%= trend[:month_label] %>
 <% if trend[:month] == @start_date %>
 <span>atual</span>
 <% end %>
 </td>
 <td>
 R$ <%= number_with_precision(trend[:income], precision: 0, delimiter: ".") %>
 </td>
 <td>
 R$ <%= number_with_precision(trend[:expenses], precision: 0, delimiter: ".") %>
 </td>
 <td>
 R$ <%= number_with_precision(trend[:balance], precision: 0, delimiter: ".") %>
 </td>
 <td>
 <%= trend[:savings_rate] %>%
 </td>
 </tr>
 <% end %>
 </tbody>
 </table>
 </div>

 <!-- Insights -->
 <div>
 <h4>💡 Insights</h4>
 <div>
 <div>
 <span>Melhor mês:</span> 
 <%= @best_month[:month_label] %> (<%= @best_month[:savings_rate] %>% poupança)
 </div>
 <div>
 <span>Pior mês:</span> 
 <%= @worst_month[:month_label] %> (<%= @worst_month[:savings_rate] %>% poupança)
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- Credit Card Analysis -->
 <div>
 <div>
 <h3>💳 Análise Cartão de Crédito</h3>
 
 <% if @credit_statements.any? %>
 <div>
 <div>
 <div>Total a Pagar</div>
 <div>R$ <%= number_with_precision(@cc_total_due, precision: 2, delimiter: ".") %></div>
 </div>
 <div>
 <div>Total Pago</div>
 <div>R$ <%= number_with_precision(@cc_total_paid, precision: 2, delimiter: ".") %></div>
 </div>
 <div>
 <div>Pendente</div>
 <div>R$ <%= number_with_precision(@cc_pending, precision: 2, delimiter: ".") %></div>
 </div>
 </div>

 <!-- Status breakdown -->
 <div>
 <h4>Status das Faturas</h4>
 <div>
 <% @cc_status_breakdown.each do |status, count| %>
 <div>
 <%= status.humanize %>: <%= count %>
 </div>
 <% end %>
 </div>
 </div>

 <!-- Individual statements -->
 <div>
 <% @credit_statements.each do |statement| %>
 <div>
 <div>
 <div><%= statement.account.name %></div>
 <div>
 Fatura de <%= statement.month %>
 <% if statement.due_on %>
 • Vence em <%= l(statement.due_on, format: :short) %>
 <% end %>
 </div>
 </div>
 <div>
 <div>R$ <%= number_with_precision(statement.amount_due, precision: 2, delimiter: ".") %></div>
 <div>
 <%= statement.status.humanize %>
 </div>
 </div>
 </div>
 <% end %>
 </div>
 <% else %>
 <div>
 <div>💳</div>
 <p>Nenhuma fatura de cartão no período</p>
 </div>
 <% end %>
 </div>
 </div>

 <!-- Financial Health Summary -->
 <div>
 <div>
 <h3>🏥 Saúde Financeira</h3>
 
 <div>
 <!-- Savings Rate Health -->
 <div>
 <div>
 <div>Taxa de Poupança</div>
 <div>Recomendado: 20%+</div>
 </div>
 <div>
 <div>
 <%= @savings_rate %>%
 </div>
 <div>
 <%= if @savings_rate >= 20
 '✅ Excelente'
 elsif @savings_rate >= 10
 '⚠️ Razoável'
 else
 '❌ Atenção'
 end %>
 </div>
 </div>
 </div>

 <!-- Monthly Balance Health -->
 <div>
 <div>
 <div>Saldo Mensal</div>
 <div>Positivo é saudável</div>
 </div>
 <div>
 <div>
 R$ <%= number_with_precision(@balance, precision: 0, delimiter: ".") %>
 </div>
 <div>
 <%= @balance >= 0 ? '✅ Positivo' : '❌ Negativo' %>
 </div>
 </div>
 </div>

 <!-- Credit Card Health -->
 <div>
 <div>
 <div>Cartões de Crédito</div>
 <div>Faturas em dia</div>
 </div>
 <div>
 <div>
 <%= @cc_status_breakdown['paid'] || 0 %>/<%= @credit_statements.count %>
 </div>
 <div>
 <%= @cc_pending == 0 ? '✅ Em dia' : '⚠️ Pendências' %>
 </div>
 </div>
 </div>
 </div>

 <!-- Timeline Visualizations -->
 <div data-controller="chart">
 <h4>📈 Visualizações de Timeline</h4>
 
 <!-- Chart Controls -->
 <div>
 <button data-action="click->chart#show" data-chart-type="expense-trends">
 Tendência de Despesas
 </button>
 <button data-action="click->chart#show" data-chart-type="income-vs-expense">
 Receitas vs Despesas
 </button>
 <button data-action="click->chart#show" data-chart-type="savings-rate">
 Taxa de Poupança
 </button>
 <button data-action="click->chart#show" data-chart-type="category-breakdown">
 Gastos por Categoria
 </button>
 </div>
 
 <!-- Chart Container -->
 <div>
 <div>
 <div data-chart-target="container" id="timeline-chart" style="min-height: 350px;">
 <div>
 <div>
 <div>📊</div>
 <p>Selecione um tipo de visualização acima</p>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 
 <!-- Progress Cards -->
 <div>
 <!-- Monthly Progress -->
 <div>
 <div>
 <h3>📅 Progresso Mensal</h3>
 <div>
 <div>
 <span>Meta: R$ 5.000</span>
 <span><%= ((@expense_total / 5000.0) * 100).round(1) %>%</span>
 </div>
 <progress value="<%= @expense_total %>" max="5000"></progress>
 </div>
 <div>
 Gastos este mês: R$ <%= number_with_precision(@expense_total, precision: 0, delimiter: ".") %>
 </div>
 </div>
 </div>
 
 <!-- Savings Goal -->
 <div>
 <div>
 <h3>🎯 Meta de Poupança</h3>
 <div>
 <div>
 <span>Meta: 20%</span>
 <span><%= @savings_rate %>%</span>
 </div>
 <progress 
 value="<%= [@savings_rate, 0].max %>" max="20"></progress>
 </div>
 <div>
 <% if @savings_rate >= 20 %>
 🎉 Meta atingida!
 <% elsif @savings_rate > 0 %>
 Faltam <%= (20 - @savings_rate).round(1) %>% para a meta
 <% else %>
 Déficit de <%= @savings_rate.abs %>%
 <% end %>
 </div>
 </div>
 </div>
 
 <!-- Budget Health -->
 <div>
 <div>
 <h3>💊 Saúde Financeira</h3>
 <div>
 <% health_score = [@savings_rate + 20, 0].max %>
 <div>
 <span>Score</span>
 <span><%= health_score.round(1) %>/40</span>
 </div>
 <progress value="<%= health_score %>" max="40"></progress>
 </div>
 <div>
 <% if health_score >= 30 %>
 🟢 Excelente
 <% elsif health_score >= 20 %>
 🟡 Bom
 <% elsif health_score >= 10 %>
 🟠 Regular
 <% else %>
 🔴 Precisa atenção
 <% end %>
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- Quick Actions -->
 <div>
 <h4>🚀 Ações Rápidas</h4>
 <div>
 <%= link_to "Ver Transações", transactions_path %>
 <%= link_to "Ver Faturas", credit_statements_path %>
 <%= link_to "Dashboard", overview_index_path %>
 </div>
 </div>
 </div>
 </div>
</div>

<!-- Projected Transactions Section -->
<div>
 <div>
 <h3>🔮 Lançamentos Previstos (Projeção de Compromissos)</h3>
 <% if @projected_transactions.any? %>
 <ul>
 <% @projected_transactions.each do |proj| %>
 <li>
 <span>
 <%= proj[:description] %>
 <span><%= l(proj[:date], format: :short) %></span>
 <span title="Este lançamento ainda não foi realizado, previsão automática">previsto</span>
 </span>
 <span>R$ <%= number_with_precision(proj[:amount], precision: 2) %></span>
 </li>
 <% end %>
 </ul>
 <div>
 <span><i class="fa fa-eye"></i> Lançamentos previstos são projeções automáticas dos próximos 3 meses de compromissos recorrentes. O horizonte é calculado a partir da data exata, não até o final do mês.</span>
 </div>
 <% else %>
 <div>
 <div>🔮</div>
 <p>Nenhum lançamento previsto para este mês</p>
 </div>
 <% end %>
 </div>
</div>

<!-- Totais projetados -->
<div>
 <div>
 <div>
 <h2>💰 Receitas Projetadas</h2>
 <p>R$ <%= number_with_precision(@projected_income_total, precision: 2, delimiter: ".") %></p>
 </div>
 </div>
 <div>
 <div>
 <h2>💸 Despesas Projetadas</h2>
 <p>R$ <%= number_with_precision(@projected_expense_total, precision: 2, delimiter: ".") %></p>
 </div>
 </div>
 <div>
 <div>
 <h2>🔮 Saldo Projetado</h2>
 <p>R$ <%= number_with_precision(@projected_balance, precision: 2, delimiter: ".") %></p>
 </div>
 </div>
</div>

