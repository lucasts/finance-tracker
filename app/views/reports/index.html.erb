<h1 class="text-3xl font-bold mb-6">📊 <%= t('ui.navigation.reports') %></h1>

<!-- Month navigation -->
<div class="flex items-center justify-between mb-6">
  <div class="flex items-center gap-2">
    <%= link_to '<', reports_path(month: @prev_month), class: "btn btn-sm btn-ghost" %>
    <span class="text-xl font-bold"><%= @selected_month_long %></span>
    <%= link_to '>', reports_path(month: @next_month), class: "btn btn-sm btn-ghost" %>
  </div>
  
  <div class="flex gap-2">
    <%= link_to "📈 Dashboard", overview_index_path, class: "btn btn-sm btn-outline" %>
    <%= link_to "💳 Faturas", credit_statements_path, class: "btn btn-sm btn-outline" %>
  </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">
  <!-- Total Transactions -->
  <div class="card bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20">
    <div class="card-body">
      <h2 class="card-title text-primary">📝 Transações</h2>
      <p class="text-2xl font-bold"><%= @total_transactions %></p>
      <div class="text-xs text-base-content/60">
        <span class="text-success"><%= @income_count %> receitas</span> • 
        <span class="text-error"><%= @expense_count %> despesas</span>
      </div>
    </div>
  </div>

  <!-- Income -->
  <div class="card bg-gradient-to-br from-success/10 to-success/5 border border-success/20">
    <div class="card-body">
      <h2 class="card-title text-success">💰 Receitas</h2>
      <p class="text-2xl font-bold">R$ <%= number_with_precision(@income_total, precision: 2, delimiter: ".") %></p>
    </div>
  </div>

  <!-- Expenses -->
  <div class="card bg-gradient-to-br from-error/10 to-error/5 border border-error/20">
    <div class="card-body">
      <h2 class="card-title text-error">💸 Despesas</h2>
      <p class="text-2xl font-bold">R$ <%= number_with_precision(@expense_total, precision: 2, delimiter: ".") %></p>
    </div>
  </div>

  <!-- Savings Rate -->
  <div class="card bg-gradient-to-br from-info/10 to-info/5 border border-info/20">
    <div class="card-body">
      <h2 class="card-title text-info">💎 Taxa de Poupança</h2>
      <p class="text-2xl font-bold <%= @savings_rate >= 0 ? 'text-success' : 'text-error' %>"><%= @savings_rate %>%</p>
      <div class="text-xs text-base-content/60">
        Média 6m: <span class="font-semibold"><%= @avg_savings_rate %>%</span>
      </div>
    </div>
  </div>
</div>

<!-- Main Content Grid -->
<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
  
  <!-- Category Analysis -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title mb-4">🏷️ Análise por Categoria</h3>
      
      <% if @category_percentages.any? %>
        <div class="space-y-3">
          <% @category_percentages.each do |category, amount, percentage| %>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex justify-between items-center mb-1">
                  <span class="text-sm font-medium"><%= category %></span>
                  <span class="text-sm text-base-content/70"><%= percentage %>%</span>
                </div>
                <div class="w-full bg-base-300 rounded-full h-2">
                  <div class="bg-primary h-2 rounded-full transition-all duration-300" 
                       style="width: <%= percentage %>%"></div>
                </div>
              </div>
              <div class="ml-4 text-right">
                <div class="font-semibold">R$ <%= number_with_precision(amount, precision: 2, delimiter: ".") %></div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-base-content/60 py-8">
          <div class="text-4xl mb-2">📊</div>
          <p>Nenhuma despesa categorizada no período</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Monthly Trends -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title mb-4">📈 Tendências (6 Meses)</h3>
      
      <div class="overflow-x-auto">
        <table class="table table-zebra w-full">
          <thead>
            <tr>
              <th>Mês</th>
              <th class="text-right">Receitas</th>
              <th class="text-right">Despesas</th>
              <th class="text-right">Saldo</th>
              <th class="text-right">Taxa Poupança</th>
            </tr>
          </thead>
          <tbody>
            <% @monthly_trends.each do |trend| %>
              <tr class="<%= trend[:month] == @start_date ? 'bg-primary/10' : '' %>">
                <td class="font-medium">
                  <%= trend[:month_label] %>
                  <% if trend[:month] == @start_date %>
                    <span class="badge badge-primary badge-xs ml-1">atual</span>
                  <% end %>
                </td>
                <td class="text-right text-success">
                  R$ <%= number_with_precision(trend[:income], precision: 0, delimiter: ".") %>
                </td>
                <td class="text-right text-error">
                  R$ <%= number_with_precision(trend[:expenses], precision: 0, delimiter: ".") %>
                </td>
                <td class="text-right font-semibold <%= trend[:balance] >= 0 ? 'text-success' : 'text-error' %>">
                  R$ <%= number_with_precision(trend[:balance], precision: 0, delimiter: ".") %>
                </td>
                <td class="text-right font-semibold <%= trend[:savings_rate] >= 0 ? 'text-success' : 'text-error' %>">
                  <%= trend[:savings_rate] %>%
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Insights -->
      <div class="mt-4 p-4 bg-base-200 rounded-lg">
        <h4 class="font-semibold mb-2">💡 Insights</h4>
        <div class="text-sm space-y-1">
          <div>
            <span class="font-medium text-success">Melhor mês:</span> 
            <%= @best_month[:month_label] %> (<%= @best_month[:savings_rate] %>% poupança)
          </div>
          <div>
            <span class="font-medium text-error">Pior mês:</span> 
            <%= @worst_month[:month_label] %> (<%= @worst_month[:savings_rate] %>% poupança)
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Credit Card Analysis -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title mb-4">💳 Análise Cartão de Crédito</h3>
      
      <% if @credit_statements.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
          <div class="stat">
            <div class="stat-title">Total a Pagar</div>
            <div class="stat-value text-error text-lg">R$ <%= number_with_precision(@cc_total_due, precision: 2, delimiter: ".") %></div>
          </div>
          <div class="stat">
            <div class="stat-title">Total Pago</div>
            <div class="stat-value text-success text-lg">R$ <%= number_with_precision(@cc_total_paid, precision: 2, delimiter: ".") %></div>
          </div>
          <div class="stat">
            <div class="stat-title">Pendente</div>
            <div class="stat-value text-warning text-lg">R$ <%= number_with_precision(@cc_pending, precision: 2, delimiter: ".") %></div>
          </div>
        </div>

        <!-- Status breakdown -->
        <div class="mb-4">
          <h4 class="font-semibold mb-2">Status das Faturas</h4>
          <div class="flex gap-2 flex-wrap">
            <% @cc_status_breakdown.each do |status, count| %>
              <div class="badge <%= status == 'paid' ? 'badge-success' : 
                                   status == 'overdue' ? 'badge-error' : 
                                   'badge-warning' %>">
                <%= status.humanize %>: <%= count %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Individual statements -->
        <div class="space-y-2">
          <% @credit_statements.each do |statement| %>
            <div class="flex items-center justify-between p-3 bg-base-200 rounded">
              <div>
                <div class="font-medium"><%= statement.account.name %></div>
                <div class="text-sm text-base-content/70">
                  Fatura de <%= statement.month %>
                  <% if statement.due_on %>
                    • Vence em <%= l(statement.due_on, format: :short) %>
                  <% end %>
                </div>
              </div>
              <div class="text-right">
                <div class="font-semibold">R$ <%= number_with_precision(statement.amount_due, precision: 2, delimiter: ".") %></div>
                <div class="badge badge-xs <%= statement.status == 'paid' ? 'badge-success' : 
                                               statement.status == 'overdue' ? 'badge-error' : 
                                               'badge-warning' %>">
                  <%= statement.status.humanize %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center text-base-content/60 py-8">
          <div class="text-4xl mb-2">💳</div>
          <p>Nenhuma fatura de cartão no período</p>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Financial Health Summary -->
  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <h3 class="card-title mb-4">🏥 Saúde Financeira</h3>
      
      <div class="space-y-4">
        <!-- Savings Rate Health -->
        <div class="flex items-center justify-between p-3 bg-base-200 rounded">
          <div>
            <div class="font-medium">Taxa de Poupança</div>
            <div class="text-sm text-base-content/70">Recomendado: 20%+</div>
          </div>
          <div class="text-right">
            <div class="font-bold text-2xl <%= @savings_rate >= 20 ? 'text-success' : @savings_rate >= 10 ? 'text-warning' : 'text-error' %>">
              <%= @savings_rate %>%
            </div>
            <div class="text-xs">
              <%= if @savings_rate >= 20
                    '✅ Excelente'
                  elsif @savings_rate >= 10
                    '⚠️ Razoável'
                  else
                    '❌ Atenção'
                  end %>
            </div>
          </div>
        </div>

        <!-- Monthly Balance Health -->
        <div class="flex items-center justify-between p-3 bg-base-200 rounded">
          <div>
            <div class="font-medium">Saldo Mensal</div>
            <div class="text-sm text-base-content/70">Positivo é saudável</div>
          </div>
          <div class="text-right">
            <div class="font-bold text-2xl <%= @balance >= 0 ? 'text-success' : 'text-error' %>">
              R$ <%= number_with_precision(@balance, precision: 0, delimiter: ".") %>
            </div>
            <div class="text-xs">
              <%= @balance >= 0 ? '✅ Positivo' : '❌ Negativo' %>
            </div>
          </div>
        </div>

        <!-- Credit Card Health -->
        <div class="flex items-center justify-between p-3 bg-base-200 rounded">
          <div>
            <div class="font-medium">Cartões de Crédito</div>
            <div class="text-sm text-base-content/70">Faturas em dia</div>
          </div>
          <div class="text-right">
            <div class="font-bold text-2xl <%= @cc_pending == 0 ? 'text-success' : 'text-warning' %>">
              <%= @cc_status_breakdown['paid'] || 0 %>/<%= @credit_statements.count %>
            </div>
            <div class="text-xs">
              <%= @cc_pending == 0 ? '✅ Em dia' : '⚠️ Pendências' %>
            </div>
          </div>
        </div>
      </div>

      <!-- Timeline Visualizations -->
      <div class="mt-6">
        <h4 class="font-semibold mb-4">📈 Visualizações de Timeline</h4>
        
        <!-- Chart Controls -->
        <div class="flex flex-wrap gap-2 mb-4">
          <button class="btn btn-sm btn-primary" onclick="showChart('expense-trends')">
            Tendência de Despesas
          </button>
          <button class="btn btn-sm btn-outline" onclick="showChart('income-vs-expense')">
            Receitas vs Despesas
          </button>
          <button class="btn btn-sm btn-outline" onclick="showChart('savings-rate')">
            Taxa de Poupança
          </button>
          <button class="btn btn-sm btn-outline" onclick="showChart('category-breakdown')">
            Gastos por Categoria
          </button>
        </div>
        
        <!-- Chart Container -->
        <div class="card bg-base-100 shadow">
          <div class="card-body">
            <div id="timeline-chart" style="min-height: 350px;">
              <div class="flex items-center justify-center h-80">
                <div class="text-center">
                  <div class="text-4xl mb-4">📊</div>
                  <p class="text-base-content/60">Selecione um tipo de visualização acima</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Progress Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
          <!-- Monthly Progress -->
          <div class="card bg-gradient-to-br from-primary/10 to-primary/5 border border-primary/20">
            <div class="card-body">
              <h3 class="card-title text-primary text-base">📅 Progresso Mensal</h3>
              <div class="mt-2">
                <div class="flex justify-between text-sm mb-1">
                  <span>Meta: R$ 5.000</span>
                  <span><%= ((@expense_total / 5000.0) * 100).round(1) %>%</span>
                </div>
                <progress class="progress progress-primary w-full" value="<%= @expense_total %>" max="5000"></progress>
              </div>
              <div class="text-xs text-base-content/60 mt-2">
                Gastos este mês: R$ <%= number_with_precision(@expense_total, precision: 0, delimiter: ".") %>
              </div>
            </div>
          </div>
          
          <!-- Savings Goal -->
          <div class="card bg-gradient-to-br from-success/10 to-success/5 border border-success/20">
            <div class="card-body">
              <h3 class="card-title text-success text-base">🎯 Meta de Poupança</h3>
              <div class="mt-2">
                <div class="flex justify-between text-sm mb-1">
                  <span>Meta: 20%</span>
                  <span><%= @savings_rate %>%</span>
                </div>
                <progress class="progress progress-success w-full" 
                         value="<%= [@savings_rate, 0].max %>" max="20"></progress>
              </div>
              <div class="text-xs text-base-content/60 mt-2">
                <% if @savings_rate >= 20 %>
                  🎉 Meta atingida!
                <% elsif @savings_rate > 0 %>
                  Faltam <%= (20 - @savings_rate).round(1) %>% para a meta
                <% else %>
                  Déficit de <%= @savings_rate.abs %>%
                <% end %>
              </div>
            </div>
          </div>
          
          <!-- Budget Health -->
          <div class="card bg-gradient-to-br from-info/10 to-info/5 border border-info/20">
            <div class="card-body">
              <h3 class="card-title text-info text-base">💊 Saúde Financeira</h3>
              <div class="mt-2">
                <% health_score = [@savings_rate + 20, 0].max %>
                <div class="flex justify-between text-sm mb-1">
                  <span>Score</span>
                  <span><%= health_score.round(1) %>/40</span>
                </div>
                <progress class="progress progress-info w-full" value="<%= health_score %>" max="40"></progress>
              </div>
              <div class="text-xs text-base-content/60 mt-2">
                <% if health_score >= 30 %>
                  🟢 Excelente
                <% elsif health_score >= 20 %>
                  🟡 Bom
                <% elsif health_score >= 10 %>
                  🟠 Regular
                <% else %>
                  🔴 Precisa atenção
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="mt-6">
        <h4 class="font-semibold mb-2">🚀 Ações Rápidas</h4>
        <div class="flex gap-2 flex-wrap">
          <%= link_to "Ver Transações", transactions_path, class: "btn btn-xs btn-outline" %>
          <%= link_to "Ver Faturas", credit_statements_path, class: "btn btn-xs btn-outline" %>
          <%= link_to "Dashboard", overview_index_path, class: "btn btn-xs btn-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js Integration -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
let currentChart = null;

// Sample data - in production this would come from the backend
const chartData = {
  labels: [<%= @monthly_trends.map { |t| "'#{t[:month_label]}'" }.join(', ') %>],
  monthlyTrends: <%= @monthly_trends.to_json.html_safe %>,
  categories: <%= (@categories_analysis&.keys || []).map(&:to_s).to_json.html_safe %>,
  categoryAmounts: <%= (@categories_analysis&.values || []).to_json.html_safe %>
};

function showChart(type) {
  const ctx = document.getElementById('timeline-chart');
  
  // Clear existing chart
  if (currentChart) {
    currentChart.destroy();
  }
  
  // Update button states
  document.querySelectorAll('.btn').forEach(btn => {
    btn.classList.remove('btn-primary');
    btn.classList.add('btn-outline');
  });
  event.target.classList.remove('btn-outline');
  event.target.classList.add('btn-primary');
  
  let config = {};
  
  switch(type) {
    case 'expense-trends':
      config = {
        type: 'line',
        data: {
          labels: chartData.labels,
          datasets: [{
            label: 'Despesas',
            data: chartData.monthlyTrends.map(t => t.expenses),
            borderColor: 'rgb(239, 68, 68)',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            title: {
              display: true,
              text: 'Tendência de Despesas por Mês'
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return 'R$ ' + value.toLocaleString('pt-BR');
                }
              }
            }
          }
        }
      };
      break;
      
    case 'income-vs-expense':
      config = {
        type: 'bar',
        data: {
          labels: chartData.labels,
          datasets: [
            {
              label: 'Receitas',
              data: chartData.monthlyTrends.map(t => t.income),
              backgroundColor: 'rgba(34, 197, 94, 0.8)',
              borderColor: 'rgb(34, 197, 94)',
              borderWidth: 1
            },
            {
              label: 'Despesas',
              data: chartData.monthlyTrends.map(t => t.expenses),
              backgroundColor: 'rgba(239, 68, 68, 0.8)',
              borderColor: 'rgb(239, 68, 68)',
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            title: {
              display: true,
              text: 'Receitas vs Despesas por Mês'
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(value) {
                  return 'R$ ' + value.toLocaleString('pt-BR');
                }
              }
            }
          }
        }
      };
      break;
      
    case 'savings-rate':
      config = {
        type: 'line',
        data: {
          labels: chartData.labels,
          datasets: [{
            label: 'Taxa de Poupança (%)',
            data: chartData.monthlyTrends.map(t => t.savings_rate),
            borderColor: 'rgb(59, 130, 246)',
            backgroundColor: 'rgba(59, 130, 246, 0.1)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            title: {
              display: true,
              text: 'Taxa de Poupança por Mês'
            }
          },
          scales: {
            y: {
              ticks: {
                callback: function(value) {
                  return value + '%';
                }
              }
            }
          }
        }
      };
      break;
      
    case 'category-breakdown':
      config = {
        type: 'doughnut',
        data: {
          labels: chartData.categories,
          datasets: [{
            data: chartData.categoryAmounts,
            backgroundColor: [
              'rgba(239, 68, 68, 0.8)',
              'rgba(34, 197, 94, 0.8)',
              'rgba(59, 130, 246, 0.8)',
              'rgba(245, 158, 11, 0.8)',
              'rgba(139, 92, 246, 0.8)',
              'rgba(236, 72, 153, 0.8)',
              'rgba(14, 165, 233, 0.8)',
              'rgba(34, 197, 94, 0.8)'
            ],
            borderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            title: {
              display: true,
              text: 'Gastos por Categoria (Mês Atual)'
            },
            legend: {
              position: 'right'
            }
          }
        }
      };
      break;
  }
  
  currentChart = new Chart(ctx, config);
}

// Auto-load first chart
document.addEventListener('DOMContentLoaded', function() {
  // Trigger first chart automatically
  const firstButton = document.querySelector('[onclick="showChart(\'expense-trends\')"]');
  if (firstButton) {
    firstButton.click();
  }
});
</script>

<!-- Advanced Insights Dashboard -->
<div class="card bg-base-100 shadow mt-8">
  <div class="card-body">
    <h2 class="card-title mb-6">🔍 Insights e Análises Avançadas</h2>
    
    <!-- Quick Insights Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <!-- Variable Expenses Insight -->
      <div class="card bg-gradient-to-br from-info/10 to-info/5 border border-info/20">
        <div class="card-body p-4">
          <h3 class="font-semibold text-info mb-2">💡 Gastos Variáveis</h3>
          <% variable_categories = @category_breakdown.first(3).select { |cat, amount| ['Supermercado', 'Farmácia', 'Combustível', 'Restaurante'].any? { |keyword| cat.include?(keyword) } } %>
          <% if variable_categories.any? %>
            <div class="text-sm space-y-1">
              <% variable_categories.each do |category, amount| %>
                <div class="flex justify-between">
                  <span><%= category %></span>
                  <span class="font-bold">R$ <%= number_with_precision(amount, precision: 0, delimiter: ".") %></span>
                </div>
              <% end %>
            </div>
            <div class="mt-3">
              <%= link_to "📊 Análise Detalhada", variable_expenses_analysis_reports_path, 
                          class: "btn btn-info btn-xs w-full" %>
            </div>
          <% else %>
            <p class="text-sm text-base-content/60">Sem gastos variáveis significativos este mês.</p>
          <% end %>
        </div>
      </div>
      
      <!-- Savings Progress -->
      <div class="card bg-gradient-to-br from-success/10 to-success/5 border border-success/20">
        <div class="card-body p-4">
          <h3 class="font-semibold text-success mb-2">💰 Poupança</h3>
          <div class="text-lg font-bold mb-2">
            <%= @savings_rate > 0 ? "#{@savings_rate}%" : "0%" %>
          </div>
          <div class="text-sm mb-3">
            <% if @savings_rate > 20 %>
              <span class="text-success">✅ Excelente!</span>
            <% elsif @savings_rate > 10 %>
              <span class="text-warning">⚡ Bom ritmo</span>
            <% elsif @savings_rate > 0 %>
              <span class="text-info">📈 Progredindo</span>
            <% else %>
              <span class="text-error">⚠️ Atenção</span>
            <% end %>
          </div>
          <div class="w-full bg-base-300 rounded-full h-2">
            <div class="bg-success rounded-full h-2" style="width: <%= [@savings_rate, 100].min %>%"></div>
          </div>
        </div>
      </div>
      
      <!-- Monthly Comparison -->
      <div class="card bg-gradient-to-br from-warning/10 to-warning/5 border border-warning/20">
        <div class="card-body p-4">
          <h3 class="font-semibold text-warning mb-2">📈 Comparação</h3>
          <% if @monthly_trends.length >= 2 %>
            <% current_month = @monthly_trends.last %>
            <% prev_month = @monthly_trends[-2] %>
            <% expense_change = prev_month[:expenses] > 0 ? ((current_month[:expenses] - prev_month[:expenses]) / prev_month[:expenses] * 100).round(1) : 0 %>
            <div class="text-sm space-y-1">
              <div class="flex justify-between">
                <span>Despesas vs mês anterior</span>
                <span class="font-bold <%= expense_change > 0 ? 'text-error' : 'text-success' %>">
                  <%= expense_change > 0 ? '+' : '' %><%= expense_change %>%
                </span>
              </div>
              <div class="flex justify-between">
                <span>Saldo vs mês anterior</span>
                <% balance_change = prev_month[:balance] != 0 ? ((current_month[:balance] - prev_month[:balance]) / prev_month[:balance] * 100).round(1) : 0 %>
                <span class="font-bold <%= balance_change > 0 ? 'text-success' : 'text-error' %>">
                  <%= balance_change > 0 ? '+' : '' %><%= balance_change %>%
                </span>
              </div>
            </div>
          <% else %>
            <p class="text-sm text-base-content/60">Dados insuficientes para comparação.</p>
          <% end %>
        </div>
      </div>
    </div>
    
    <!-- Detailed Analysis Actions -->
    <div class="divider">Análises Detalhadas</div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="card bg-base-200 hover:bg-base-300 transition-colors cursor-pointer">
        <div class="card-body p-4 text-center">
          <div class="text-2xl mb-2">📊</div>
          <h4 class="font-semibold">Gastos Variáveis</h4>
          <p class="text-xs text-base-content/60 mb-3">Análise de padrões e tendências</p>
          <%= link_to "Analisar", variable_expenses_analysis_reports_path, 
                      class: "btn btn-primary btn-sm w-full" %>
        </div>
      </div>
      
      <div class="card bg-base-200 hover:bg-base-300 transition-colors cursor-pointer">
        <div class="card-body p-4 text-center">
          <div class="text-2xl mb-2">💳</div>
          <h4 class="font-semibold">Cartões de Crédito</h4>
          <p class="text-xs text-base-content/60 mb-3">Análise de faturas e gastos</p>
          <%= link_to "Ver Faturas", credit_statements_path, 
                      class: "btn btn-secondary btn-sm w-full" %>
        </div>
      </div>
      
      <div class="card bg-base-200 hover:bg-base-300 transition-colors cursor-pointer">
        <div class="card-body p-4 text-center">
          <div class="text-2xl mb-2">🔄</div>
          <h4 class="font-semibold">Compromissos</h4>
          <p class="text-xs text-base-content/60 mb-3">Recorrentes e parcelamentos</p>
          <%= link_to "Gerenciar", recurring_commitments_path, 
                      class: "btn btn-accent btn-sm w-full" %>
        </div>
      </div>
      
      <div class="card bg-base-200 hover:bg-base-300 transition-colors cursor-pointer">
        <div class="card-body p-4 text-center">
          <div class="text-2xl mb-2">🤖</div>
          <h4 class="font-semibold">Automação</h4>
          <p class="text-xs text-base-content/60 mb-3">Status e controles</p>
          <%= link_to "Configurar", automation_index_path, 
                      class: "btn btn-info btn-sm w-full" %>
        </div>
      </div>
    </div>
  </div>
</div>
