<% content_for :title, t('ui.navigation.recurring_commitments') %>

<div>
 <!-- Header -->
 <div>
 <div>
 <h1><%= t('ui.navigation.recurring_commitments') %></h1>
 <p><%= t('ui.recurring_commitment.index.description') %></p>
 </div>
 
 <%= link_to new_recurring_commitment_path do %>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
 </svg>
 <%= t('ui.actions.new') %> <%= t('activerecord.models.recurring_commitment.one') %>
 <% end %>
 </div>

 <% if @commitment_summaries.any? %>
 <!-- Stats Cards -->
 <div>
 <div>
 <div>Compromissos Ativos</div>
 <div><%= @commitment_summaries.count %></div>
 </div>
 
 <div>
 <div>Valor Total Mensal</div>
 <div>
 R$ <%= number_with_precision(@commitment_summaries.sum { |s| s[:commitment].default_amount || 0 }, precision: 2, delimiter: '.', separator: ',') %>
 </div>
 </div>
 
 <div>
 <div>Próximo Vencimento</div>
 <div>
 <%= @commitment_summaries.map { |s| s[:next_occurrence] }.compact.min&.strftime('%d/%m') || 'N/A' %>
 </div>
 </div>
 </div>

 <!-- Commitments List -->
 <div>
 <% @commitment_summaries.each do |summary| %>
 <% commitment = summary[:commitment] %>
 <div>
 <div>
 <div>
 <div>
 <div>
 <h3>
 <%= commitment.name %>
 </h3>
 
 <!-- Status Badge -->
 <div>
 <%= commitment.active? ? '✓ Ativo' : '⏸ Pausado' %>
 </div>
 
 <!-- Frequency Badge -->
 <div>
 <%= t("ui.transaction.recurring.frequencies.#{commitment.recurrence_frequency}") %>
 </div>
 </div>
 
 <div>
 <span>Categoria:</span> <%= commitment.category.name %>
 </div>
 
 <!-- Amount and Stats -->
 <div>
 <div>
 <span>Valor Padrão:</span><br>
 <span>
 R$ <%= number_with_precision(commitment.default_amount || 0, precision: 2, delimiter: '.', separator: ',') %>
 </span>
 </div>
 
 <div>
 <span>Total Gasto:</span><br>
 <span>
 R$ <%= number_with_precision(summary[:total_spent] || 0, precision: 2, delimiter: '.', separator: ',') %>
 </span>
 </div>
 
 <div>
 <span>Próximo Vencimento:</span><br>
 <span>
 <%= summary[:next_occurrence]&.strftime('%d/%m/%Y') || 'N/A' %>
 </span>
 </div>
 
 <div>
 <span>Transações:</span><br>
 <span><%= summary[:transaction_count] %></span>
 </div>
 </div>
 </div>
 
 <!-- Action Buttons -->
 <div>
 <%= link_to recurring_commitment_path(commitment) do %>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
 </svg>
 Ver
 <% end %>
 
 <%= link_to edit_recurring_commitment_path(commitment) do %>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
 </svg>
 Editar
 <% end %>
 
 <%= link_to toggle_active_recurring_commitment_path(commitment), 
 method: :patch, 
 
 data: { 
 confirm: "Tem certeza que deseja #{commitment.active? ? 'pausar' : 'ativar'} este compromisso?" 
 } do %>
 <%= commitment.active? ? '⏸ Pausar' : '▶ Ativar' %>
 <% end %>
 </div>
 </div>
 </div>
 </div>
 <% end %>
 </div>
 <% else %>
 <!-- Empty State -->
 <div>
 <div>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
 </svg>
 </div>
 
 <h3>Nenhum compromisso recorrente</h3>
 <p>
 Compromissos recorrentes ajudam a automatizar gastos fixos como aluguel, assinaturas e contas mensais.
 </p>
 
 <%= link_to new_recurring_commitment_path do %>
 <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
 </svg>
 Criar Primeiro Compromisso
 <% end %>
 </div>
 <% end %>
</div>
