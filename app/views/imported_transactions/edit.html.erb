<section class="reconciliation-page">
  <!-- Breadcrumbs -->
  <ul class="breadcrumbs">
    <li><%= link_to "Importações", import_sessions_path %></li>
    <li><%= link_to @import_session.original_filename, import_session_path(@import_session) %></li>
    <li>Conciliação</li>
  </ul>

  <!-- Header -->
  <header class="page-header">
    <div class="header-left">
      <h1>Conciliação de Transação</h1>
      <p>Linha <%= @imported_transaction.line_number %> · Analise e decida o que fazer com esta transação</p>
    </div>
  </header>

  <div class="reconciliation-grid">
    <!-- Coluna esquerda: Dados importados -->
    <div class="left-column">
      <!-- Card da transação importada -->
      <div class="detail-card">
        <h2>
          Transação Importada
          <span class="line-badge">Linha <%= @imported_transaction.line_number %></span>
        </h2>

        <div class="imported-fields">
          <div class="field-row">
            <div class="field-group">
              <label>Descrição</label>
              <div class="field-value"><%= @imported_transaction.description %></div>
            </div>
            <div class="field-group">
              <label>Valor</label>
              <div class="field-value amount"><%= format_money(@imported_transaction.amount) %></div>
            </div>
          </div>

          <div class="field-row">
            <div class="field-group">
              <label>Data do Evento</label>
              <div class="field-value"><%= l(@imported_transaction.event_date, format: :long) if @imported_transaction.event_date %></div>
            </div>
            <div class="field-group">
              <label>Data de Pagamento</label>
              <div class="field-value"><%= l(@imported_transaction.payment_date, format: :long) if @imported_transaction.payment_date %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Sugestões do sistema -->
      <div class="detail-card">
        <h2>Sugestões Inteligentes</h2>

        <% if @matches[:installment_plan] %>
          <div class="suggestion-alert">
            <strong>Parcelamento Detectado!</strong>
            <span>Possível parcela do plano: <strong><%= @matches[:installment_plan].name %></strong></span>
          </div>
        <% end %>

        <% if @matches[:recurring_commitment] %>
          <div class="suggestion-alert">
            <strong>Compromisso Recorrente Detectado!</strong>
            <span>Possível ocorrência do compromisso: <strong><%= @matches[:recurring_commitment].name %></strong></span>
          </div>
        <% end %>

        <% if @matches[:candidates].present? %>
          <div class="candidates-section">
            <h3>Transações Existentes Similares</h3>
            <div class="candidates-list">
              <% @matches[:candidates].each do |tx| %>
                <label class="candidate-card" id="tx-<%= tx.id %>" for="match-<%= tx.id %>">
                  <div class="candidate-info">
                    <div class="candidate-desc"><%= tx.description %></div>
                    <div class="candidate-meta">
                      <%= l(tx.event_date, format: :short) if tx.event_date %> ·
                      <span class="candidate-amount"><%= format_money(tx.amount) %></span>
                      <% if tx.category %>
                        · <span><%= tx.category.name %></span>
                      <% end %>
                    </div>
                  </div>
                  <input type="radio" name="matched_transaction_id" value="<%= tx.id %>" id="match-<%= tx.id %>">
                </label>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="empty-suggestions">
            <span>Nenhuma transação similar encontrada</span>
          </div>
        <% end %>
      </div>

      <!-- Dados originais (expansível) -->
      <details class="detail-card raw-data-section">
        <summary>Dados Técnicos</summary>
        <div class="raw-data-content">
          <pre><%= JSON.pretty_generate(@imported_transaction.parsed_data || {}) rescue @imported_transaction.raw_data %></pre>
        </div>
      </details>
    </div>

    <!-- Coluna direita: Formulário de conciliação -->
    <div class="right-column">
      <%= form_with model: @imported_transaction, url: import_session_imported_transaction_path(@import_session, @imported_transaction), method: :put, local: true, html: { class: "form", data: { controller: "imported-transaction-form" } } do |f| %>

        <!-- Ações de conciliação -->
        <div class="detail-card">
          <h2>Ação de Conciliação</h2>

          <div class="action-options">
            <label class="action-option">
              <input type="radio" name="reconciliation_action" value="create_new" checked>
              <div class="action-option-content">
                <div class="action-option-title">Criar Nova Transação</div>
                <div class="action-option-desc">Adiciona uma nova transação ao sistema</div>
              </div>
              <span class="action-option-badge recommended">Recomendado</span>
            </label>

            <% if @matches[:candidates].present? %>
              <label class="action-option">
                <input type="radio" name="reconciliation_action" value="associate">
                <div class="action-option-content">
                  <div class="action-option-title">Associar à Existente</div>
                  <div class="action-option-desc">Vincula a uma transação já cadastrada</div>
                </div>
                <span class="action-option-badge match">Match encontrado</span>
              </label>
            <% end %>

            <label class="action-option">
              <input type="radio" name="reconciliation_action" value="ignore">
              <div class="action-option-content">
                <div class="action-option-title">Ignorar</div>
                <div class="action-option-desc">Não processa esta linha</div>
              </div>
            </label>
          </div>
        </div>

        <!-- Edição de dados -->
        <div class="detail-card">
          <h2>Editar Dados da Transação</h2>

          <fieldset class="form-fieldset">
            <div class="form-field">
              <%= f.label :description, "Descrição" %>
              <%= f.text_field :description,
                  value: @imported_transaction.description,
                  placeholder: "Descrição da transação..." %>
            </div>

            <div class="field-row">
              <div class="form-field" data-controller="currency">
                <%= f.label :amount, "Valor" %>
                <%= f.text_field :amount,
                    value: number_with_precision(@imported_transaction.amount.abs, precision: 2, delimiter: '.', separator: ','),
                    placeholder: "0,00",
                    data: {
                      controller: "currency-input currency-validation",
                      currency_input_target: "input",
                      currency_validation_target: "input helper",
                      imported_transaction_form_target: "amount",
                      action: "input->imported-transaction-form#handleAmountChange"
                    } %>
                <small data-currency-helper data-imported-transaction-form-target="amountHelper">Informe o valor da transação</small>
              </div>

              <div class="form-field">
                <%= f.label :transaction_type, "Tipo" %>
                <%= f.select :transaction_type,
                    [['Receita', 'income'], ['Despesa', 'expense'], ['Transferência', 'transfer']],
                    { selected: @imported_transaction.transaction_type || 'expense' } %>
              </div>
            </div>

            <div class="field-row">
              <div class="form-field">
                <%= f.label :event_date, "Data do Evento" %>
                <%= f.date_field :event_date, value: @imported_transaction.event_date %>
              </div>

              <div class="form-field">
                <%= f.label :payment_date, "Data do Pagamento" %>
                <%= f.date_field :payment_date, value: @imported_transaction.payment_date %>
              </div>
            </div>

            <div class="form-field">
              <%= f.label :category_id, "Categoria" %>
              <%= f.collection_select :category_id,
                  current_user.categories, :id, :name,
                  { prompt: 'Selecione uma categoria...' } %>
            </div>
          </fieldset>
        </div>

        <!-- Botões de ação -->
        <footer class="form-actions">
          <%= f.submit "Confirmar Conciliação", class: "btn-primary",
              data: { confirm: "Confirma a decisão de conciliação? Esta ação não pode ser desfeita facilmente." } %>
          <%= link_to "Cancelar", import_session_path(@import_session), class: "btn-secondary" %>
        </footer>
      <% end %>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const associateRadio = document.querySelector('input[value="associate"]');
  const transactionRadios = document.querySelectorAll('input[name="matched_transaction_id"]');

  transactionRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      document.querySelectorAll('.candidate-card').forEach(card => card.classList.remove('selected'));
      if (this.checked) {
        const selectedCard = document.getElementById('tx-' + this.value);
        if (selectedCard) selectedCard.classList.add('selected');
        if (associateRadio) associateRadio.checked = true;
      }
    });
  });
});

function selectTransaction(transactionId) {
  const radio = document.querySelector(`input[value="${transactionId}"]`);
  if (radio) {
    radio.checked = true;
    radio.dispatchEvent(new Event('change'));
  }
  const associateRadio = document.querySelector('input[value="associate"]');
  if (associateRadio) associateRadio.checked = true;
}
</script>
